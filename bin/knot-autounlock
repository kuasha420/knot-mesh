#!/usr/bin/env /usr/bin/python3
"""
Knot KVM Authoritative Auto-Unlock Daemon (knot-autounlock)
Monitors the local knot-deskflow service for mouse entry events.
When the cursor enters this screen from another mesh node, automatically
unlocks the active Wayland/KDE display session if currently locked, and wakes
the display from DPMS sleep.
"""

import os
import sys
import time
import signal
import getpass
import subprocess

stop_requested = False

def handle_signal(signum, frame):
    global stop_requested
    sys.stderr.write(f"[knot-autounlock] Received signal {signum}, stopping...\n")
    stop_requested = True

signal.signal(signal.SIGTERM, handle_signal)
signal.signal(signal.SIGINT, handle_signal)

def get_display_session(user: str) -> str:
    """Find the active graphical display session ID for the given user."""
    # 1. Primary check via loginctl show-user Display property
    try:
        res = subprocess.run(
            ["loginctl", "show-user", user, "-p", "Display", "--value"],
            capture_output=True,
            text=True,
            check=True
        )
        sess = res.stdout.strip()
        if sess and sess != "":
            return sess
    except subprocess.CalledProcessError as e:
        sys.stderr.write(f"[knot-autounlock] loginctl show-user error: {e.stderr.strip()}\n")
    except Exception as e:
        sys.stderr.write(f"[knot-autounlock] Unexpected error checking display property: {e}\n")

    # 2. Fallback to scanning seat0 sessions for this user
    try:
        res = subprocess.run(
            ["loginctl", "list-sessions", "--no-legend"],
            capture_output=True,
            text=True,
            check=True
        )
        for line in res.stdout.strip().splitlines():
            parts = line.split()
            if len(parts) >= 4:
                sid, _uid, u, seat = parts[0], parts[1], parts[2], parts[3]
                if u == user and seat.startswith("seat"):
                    return sid
    except subprocess.CalledProcessError as e:
        sys.stderr.write(f"[knot-autounlock] loginctl list-sessions error: {e.stderr.strip()}\n")
    except Exception as e:
        sys.stderr.write(f"[knot-autounlock] Unexpected error listing sessions: {e}\n")

    # 3. Environment fallback
    env_sess = os.environ.get("XDG_SESSION_ID", "").strip()
    if env_sess:
        return env_sess

    return ""

def is_session_locked(session_id: str) -> bool:
    """Check if the specified session has LockedHint=yes."""
    if not session_id:
        return False
    try:
        res = subprocess.run(
            ["loginctl", "show-session", session_id, "-p", "LockedHint", "--value"],
            capture_output=True,
            text=True,
            check=True
        )
        return res.stdout.strip() == "yes"
    except subprocess.CalledProcessError as e:
        sys.stderr.write(f"[knot-autounlock] loginctl show-session error: {e.stderr.strip()}\n")
        return False
    except Exception as e:
        sys.stderr.write(f"[knot-autounlock] Unexpected error checking session {session_id} lock state: {e}\n")
        return False

def unlock_display_session(session_id: str, user: str) -> bool:
    """Unlock the given session and wake display monitors."""
    success = True
    try:
        subprocess.run(["loginctl", "unlock-session", session_id], check=True)
        sys.stdout.write(f"[knot-autounlock] Authoritative entry: unlocked session {session_id} for user {user}\n")
        sys.stdout.flush()
    except subprocess.CalledProcessError as e:
        sys.stderr.write(f"[knot-autounlock] Failed to unlock session {session_id}: exit code {e.returncode}\n")
        success = False
    except Exception as e:
        sys.stderr.write(f"[knot-autounlock] Unexpected error unlocking session {session_id}: {e}\n")
        success = False

    # Simulate user activity to wake up screen if in DPMS sleep and reset idle timers
    simulated = False
    for qdbus_bin in ["/usr/bin/qdbus6", "/usr/bin/qdbus", "qdbus6", "qdbus"]:
        if os.path.exists(qdbus_bin) or not qdbus_bin.startswith("/"):
            try:
                res = subprocess.run(
                    [qdbus_bin, "org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver.SimulateUserActivity"],
                    capture_output=True,
                    text=True
                )
                if res.returncode == 0:
                    simulated = True
                    break
            except Exception as e:
                sys.stderr.write(f"[knot-autounlock] Notice: ScreenSaver SimulateUserActivity check failed with {qdbus_bin}: {e}\n")
    if not simulated:
        sys.stderr.write("[knot-autounlock] Notice: ScreenSaver SimulateUserActivity not available on this seat\n")

    return success

def run_monitor():
    user = getpass.getuser()
    my_host = os.uname().nodename
    sys.stdout.write(f"[knot-autounlock] Starting KVM auto-unlock daemon for user '{user}' on '{my_host}'...\n")
    sys.stdout.flush()

    last_unlock_attempt = 0.0
    last_reconcile_attempt = 0.0
    is_anchor = ("desktop" in my_host) or ("z490" in my_host)

    if is_anchor:
        try:
            knot_bin = "/usr/local/bin/knot" if os.path.exists("/usr/local/bin/knot") else "knot"
            subprocess.Popen([knot_bin, "autologin", "reconcile"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            last_reconcile_attempt = time.time()
        except Exception as e:
            sys.stderr.write(f"[knot-autounlock] Failed to spawn autologin reconcile: {e}\n")

    while not stop_requested:
        # Use --user-unit so journalctl queries system.journal correctly across all distributions
        cmd = ["journalctl", "--user-unit=knot-deskflow.service", "-f", "-n", "0", "-o", "cat"]
        proc = None
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1
            )
        except Exception as e:
            sys.stderr.write(f"[knot-autounlock] Failed to spawn journalctl: {e}. Retrying in 3s...\n")
            time.sleep(3)
            continue

        try:
            # Use readline() in a while loop to bypass Python internal read-ahead buffering
            while not stop_requested:
                line = proc.stdout.readline()
                if not line:
                    break

                # Deskflow emits "INFO: entering screen" whenever mouse enters this node
                # Server on Anchor also emits 'switch from "..." to "<local_host>"'
                is_entry = ("entering screen" in line) or (f'to "{my_host}"' in line)
                if is_entry:
                    now = time.time()
                    if now - last_unlock_attempt < 0.4:
                        # Debounce rapid edge bounces
                        continue

                    sess = get_display_session(user)
                    if sess:
                        locked = is_session_locked(sess)
                        if locked:
                            last_unlock_attempt = now
                            sys.stdout.write(f"[knot-autounlock] Cursor entry detected on locked session {sess}. Unlocking...\n")
                            sys.stdout.flush()
                            unlock_display_session(sess, user)
                        else:
                            # Screen already unlocked; refresh idle timer
                            for qdbus_bin in ["/usr/bin/qdbus6", "/usr/bin/qdbus"]:
                                if os.path.exists(qdbus_bin):
                                    try:
                                        subprocess.run(
                                            [qdbus_bin, "org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver.SimulateUserActivity"],
                                            capture_output=True,
                                            text=True
                                        )
                                        break
                                    except Exception as e:
                                        sys.stderr.write(f"[knot-autounlock] Notice: ScreenSaver SimulateUserActivity failed with {qdbus_bin}: {e}\n")

                            if is_anchor and (now - last_reconcile_attempt > 30.0):
                                last_reconcile_attempt = now
                                try:
                                    knot_bin = "/usr/local/bin/knot" if os.path.exists("/usr/local/bin/knot") else "knot"
                                    subprocess.Popen([knot_bin, "autologin", "reconcile"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                                except Exception as e:
                                    sys.stderr.write(f"[knot-autounlock] Failed to spawn autologin reconcile: {e}\n")
                    else:
                        sys.stderr.write(f"[knot-autounlock] Warning: Could not locate active graphical session for user '{user}'\n")

        except Exception as e:
            sys.stderr.write(f"[knot-autounlock] Journal reader encountered error: {e}\n")
        finally:
            if proc:
                try:
                    proc.terminate()
                    proc.wait(timeout=2)
                except Exception as e:
                    try:
                        proc.kill()
                    except Exception as ke:
                        sys.stderr.write(f"[knot-autounlock] Notice: Failed to kill journalctl process: {ke}\n")

        if not stop_requested:
            sys.stderr.write("[knot-autounlock] Journal stream disconnected, reconnecting in 1s...\n")
            time.sleep(1)

    sys.stdout.write("[knot-autounlock] Daemon exiting gracefully.\n")
    sys.stdout.flush()

if __name__ == "__main__":
    run_monitor()
