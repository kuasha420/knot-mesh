#!/usr/bin/env /usr/bin/python3
"""
Knot Dynamic Crossover Strip Daemon (knot-stripd)
Dynamic Wayland crossover indicator strips for Anchor display in KDE Plasma 6.
Renders high-visibility, tasteful border strips along active crossover zones with
GPU-accelerated physics impulse flare animations when the cursor transitions across mesh nodes.
Dynamically adapts to the active swarm topology (Left, Right, Top, Bottom).
"""

import sys
import os
import re
import json
import glob
import shutil
import socket
import select
import signal
import subprocess
import threading
import time
from typing import Dict, List, Optional, Set

script_dir = os.path.dirname(os.path.abspath(__file__))
knot_root = os.path.abspath(os.path.join(script_dir, ".."))
if knot_root not in sys.path:
    sys.path.insert(0, knot_root)

try:
    from core.palette import resolve_swarm_palette
except ImportError:
    resolve_swarm_palette = None

from PyQt6.QtCore import QObject, pyqtSignal, pyqtProperty, QUrl, QTimer
from PyQt6.QtGui import QGuiApplication
from PyQt6.QtQml import QQmlApplicationEngine, QQmlComponent, QQmlContext

# Curated neon palette for high visual distinction across displays
DEFAULT_PALETTE = [
    "#00f0ff",  # Cyber Cyan
    "#a855f7",  # Neon Purple
    "#ffaa00",  # Amber Glow
    "#10b981",  # Emerald Green
    "#f43f5e",  # Rose Flare
    "#3b82f6",  # Bright Blue
]

QML_TEMPLATE = """
import QtQuick
import QtQuick.Window
import org.kde.layershell as LayerShell

Window {
    id: edgeWin
    visible: true
    flags: Qt.WindowTransparentForInput | Qt.FramelessWindowHint
    color: "transparent"

    LayerShell.Window.layer: LayerShell.Window.LayerOverlay
    LayerShell.Window.anchors: __ANCHORS__
    LayerShell.Window.exclusionZone: -1
    LayerShell.Window.keyboardInteractivity: LayerShell.Window.KeyboardInteractivityNone
    __MARGINS__

    width: __WIDTH__
    height: __HEIGHT__

    Item {
        id: stripItem
        anchors.fill: parent
        property int thickness: 5
        opacity: (!controller.locked && controller.connected) ? 0.45 : 0.0

        Behavior on opacity {
            NumberAnimation { duration: 250; easing.type: Easing.InOutQuad }
        }

        // Inner solid core
        Rectangle {
            anchors.fill: parent
            radius: 2
            gradient: Gradient {
                orientation: __ORIENTATION__
                GradientStop { position: 0.0; color: "transparent" }
                GradientStop { position: 0.15; color: controller.stripColor }
                GradientStop { position: 0.85; color: controller.stripColor }
                GradientStop { position: 1.0; color: "transparent" }
            }
        }

        // Outer glow
        Rectangle {
            anchors.fill: parent
            anchors.margins: -1
            radius: 3
            opacity: 0.35
            color: "transparent"
            border.width: 1
            border.color: controller.stripColor
        }

        SequentialAnimation {
            id: pulseAnim
            ParallelAnimation {
                NumberAnimation {
                    target: stripItem
                    property: "opacity"
                    to: 0.90
                    duration: 40
                    easing.type: Easing.OutQuad
                }
                NumberAnimation {
                    target: stripItem
                    property: "thickness"
                    to: 8
                    duration: 40
                    easing.type: Easing.OutQuad
                }
            }
            ParallelAnimation {
                NumberAnimation {
                    target: stripItem
                    property: "opacity"
                    to: (!controller.locked && controller.connected) ? 0.45 : 0.0
                    duration: 320
                    easing.type: Easing.OutCubic
                }
                NumberAnimation {
                    target: stripItem
                    property: "thickness"
                    to: 5
                    duration: 320
                    easing.type: Easing.OutCubic
                }
            }
        }

        Connections {
            target: controller
            function onCrossoverTriggered() {
                pulseAnim.restart();
            }
        }
    }
}
"""

class KnotEdgeController(QObject):
    connectedChanged = pyqtSignal(bool)
    lockedChanged = pyqtSignal(bool)
    crossoverTriggered = pyqtSignal()

    def __init__(self, node_id: str, edge: str, color: str, span: List[int], identifiers: Set[str], ips: Set[str], parent=None):
        super().__init__(parent)
        self.node_id = node_id
        self.edge = edge
        self.color = color
        self.span = span
        self.identifiers = {x.lower().strip() for x in identifiers if x}
        self.ips = {x.strip() for x in ips if x}
        self._connected = False
        self._locked = False

    @pyqtProperty(str, constant=True)
    def nodeId(self) -> str:
        return self.node_id

    @pyqtProperty(str, constant=True)
    def stripColor(self) -> str:
        return self.color

    @pyqtProperty(bool, notify=connectedChanged)
    def connected(self) -> bool:
        return self._connected

    @pyqtProperty(bool, notify=lockedChanged)
    def locked(self) -> bool:
        return self._locked

    def set_connected(self, state: bool):
        if self._connected != state:
            self._connected = state
            self.connectedChanged.emit(state)

    def set_locked(self, state: bool):
        if self._locked != state:
            self._locked = state
            self.lockedChanged.emit(state)

    def trigger_crossover(self):
        self.crossoverTriggered.emit()

    def matches_name(self, name: str) -> bool:
        if not name:
            return False
        clean = name.lower().strip()
        if clean in self.identifiers:
            return True
        for ident in self.identifiers:
            if ident and (clean == ident or clean in ident or ident in clean):
                return True
        return False

class KnotStripDaemon(QObject):
    def __init__(self, swarm_name: Optional[str] = None, engine_mode: str = "journal"):
        super().__init__()
        self.engine_mode = engine_mode
        self.swarm_name = swarm_name or self._detect_active_swarm()
        self.controllers: List[KnotEdgeController] = []
        self.anchor_identifiers: Set[str] = set()
        self.local_hostname = socket.gethostname().lower()
        self.active_screen = self.local_hostname
        self._stop_event = threading.Event()
        self._load_topology()

    def _detect_active_swarm(self) -> str:
        env_swarm = os.environ.get("KNOT_ACTIVE_SWARM")
        if env_swarm:
            return env_swarm.strip()

        for path in ["/run/knot/active_swarm", os.path.expanduser("~/.local/state/knot/active_swarm")]:
            if os.path.isfile(path):
                try:
                    with open(path, "r") as f:
                        s = f.read().strip()
                        if s:
                            return s
                except Exception as e:
                    sys.stderr.write(f"[knot-stripd] Warning reading {path}: {e}\n")

        swarms_dir = os.path.expanduser("~/.config/knot/swarms")
        if os.path.isdir(swarms_dir):
            for d in os.listdir(swarms_dir):
                if os.path.isfile(os.path.join(swarms_dir, d, "topology.json")):
                    return d
        return "office"

    def _load_topology(self):
        top_path = os.path.expanduser(f"~/.config/knot/swarms/{self.swarm_name}/topology.json")
        if not os.path.isfile(top_path):
            sys.stderr.write(f"[knot-stripd] Topology file not found: {top_path}\n")
            return

        try:
            with open(top_path, "r") as f:
                top_data = json.load(f)
        except Exception as e:
            sys.stderr.write(f"[knot-stripd] Error reading topology {top_path}: {e}\n")
            return

        anchor_id = top_data.get("anchor", "")
        nodes_dir = os.path.expanduser(f"~/.config/knot/swarms/{self.swarm_name}/nodes")
        all_nodes: Dict[str, dict] = {}
        if os.path.isdir(nodes_dir):
            for fname in os.listdir(nodes_dir):
                if fname.endswith(".json"):
                    nid = fname[:-5]
                    try:
                        with open(os.path.join(nodes_dir, fname), "r") as nf:
                            all_nodes[nid] = json.load(nf)
                    except Exception as e:
                        sys.stderr.write(f"[knot-stripd] Error loading node {fname}: {e}\n")



        # Resolve anchor identifiers
        self.anchor_identifiers.add(anchor_id.lower())
        self.anchor_identifiers.add(self.local_hostname)
        anchor_info = all_nodes.get(anchor_id, {})
        if anchor_info.get("hostname"):
            self.anchor_identifiers.add(anchor_info["hostname"].lower())
        for a in anchor_info.get("aliases", []):
            self.anchor_identifiers.add(a.lower())

        layout = top_data.get("layout", {})
        anchor_layout = layout.get(anchor_id, {})

        color_index = 0
        palette_len = len(DEFAULT_PALETTE)

        dynamic_palette = {}
        if resolve_swarm_palette:
            try:
                dynamic_palette = resolve_swarm_palette(
                    swarm_id=self.swarm_name,
                    topology_path=top_file,
                    nodes_dir=nodes_dir
                )
            except Exception as e:
                sys.stderr.write(f"[knot-stripd] Warning: failed to resolve dynamic palette: {e}\n")

        for edge_dir, edge_spec in anchor_layout.items():
            norm_edge = edge_dir.lower().strip()
            specs = edge_spec if isinstance(edge_spec, list) else [edge_spec]
            for spec in specs:
                if not isinstance(spec, dict):
                    continue
                target_node = spec.get("node", spec.get("target", ""))
                if not target_node:
                    continue

                span = spec.get("span", [0, 100])
                node_data = all_nodes.get(target_node, {})

                # Collect all known names & aliases for the target node
                idents: Set[str] = {target_node.lower()}
                if node_data.get("hostname"):
                    idents.add(node_data["hostname"].lower())
                for a in node_data.get("aliases", []):
                    idents.add(a.lower())

                # Collect known IPs
                ips: Set[str] = set()
                if node_data.get("ip_hint"):
                    ips.add(node_data["ip_hint"])
                if node_data.get("ip"):
                    ips.add(node_data["ip"])

                # Check cached leases
                cache_dir = os.path.expanduser("~/.cache/knot/leases")
                if os.path.isdir(cache_dir):
                    for lfile in os.listdir(cache_dir):
                        if lfile == target_node or lfile.endswith(f"_{target_node}"):
                            try:
                                with open(os.path.join(cache_dir, lfile), "r") as lf:
                                    cached_ip = lf.read().strip()
                                    if cached_ip:
                                        ips.add(cached_ip)
                            except Exception as e:
                                sys.stderr.write(f"[knot-stripd] Error reading lease {lfile}: {e}\n")

                # Determine color dynamically with topological collision avoidance
                if target_node in dynamic_palette:
                    color = dynamic_palette[target_node].hex
                elif node_data.get("strip_color"):
                    color = node_data["strip_color"]
                elif node_data.get("color"):
                    color = node_data["color"]
                else:
                    color = DEFAULT_PALETTE[color_index % palette_len]
                    color_index += 1

                ctrl = KnotEdgeController(
                    node_id=target_node,
                    edge=norm_edge,
                    color=color,
                    span=span,
                    identifiers=idents,
                    ips=ips,
                    parent=self
                )
                self.controllers.append(ctrl)
                sys.stderr.write(f"[knot-stripd] Registered edge '{norm_edge}' for node '{target_node}' (color: {color}, span: {span})\n")

    def is_local_anchor(self, name: str) -> bool:
        if not name:
            return True
        clean = name.lower().strip()
        if clean in self.anchor_identifiers:
            return True
        for ident in self.anchor_identifiers:
            if ident and (clean == ident or clean in ident or ident in clean):
                return True
        return False

    def check_lock_state(self):
        lock_file = os.path.expanduser("~/.local/state/knot/kvm_lock")
        is_locked = False
        try:
            if os.path.exists(lock_file):
                with open(lock_file, "r") as f:
                    is_locked = (f.read().strip() == "locked")
        except Exception as e:
            sys.stderr.write(f"[knot-stripd] Warning reading lock file: {e}\n")

        for ctrl in self.controllers:
            ctrl.set_locked(is_locked)

    def check_connections_via_ss(self):
        try:
            # Refresh IPs dynamically from active leases cache to handle roaming / DHCP updates
            cache_dir = os.path.expanduser("~/.cache/knot/leases")
            if os.path.isdir(cache_dir):
                for lfile in os.listdir(cache_dir):
                    for ctrl in self.controllers:
                        if lfile == ctrl.node_id or lfile.endswith(f"_{ctrl.node_id}"):
                            try:
                                with open(os.path.join(cache_dir, lfile), "r") as lf:
                                    cached_ip = lf.read().strip()
                                    if cached_ip:
                                        ctrl.ips.add(cached_ip)
                            except Exception as e:
                                sys.stderr.write(f"[knot-stripd] Notice: Failed to read cached lease {lfile}: {e}\n")

            res = subprocess.run(
                ["ss", "-t", "state", "established", "( sport = :24800 )"],
                capture_output=True, text=True, check=True
            )
            out = res.stdout
            for ctrl in self.controllers:
                connected = False
                for ip in ctrl.ips:
                    if ip and ip in out:
                        connected = True
                        break
                ctrl.set_connected(connected)
        except Exception as e:
            sys.stderr.write(f"[knot-stripd] ss check error: {e}\n")

    def start_engine(self):
        self.check_connections_via_ss()
        self.check_lock_state()

        self._timer_lock = QTimer()
        self._timer_lock.timeout.connect(self.check_lock_state)
        self._timer_lock.start(300)

        self._timer_ss = QTimer()
        self._timer_ss.timeout.connect(self.check_connections_via_ss)
        self._timer_ss.start(5000)

        if self.engine_mode == "journal":
            t_journal = threading.Thread(target=self._journal_worker, daemon=True)
            t_journal.start()

        t_kbd = threading.Thread(target=self._keyboard_worker, daemon=True)
        t_kbd.start()

    def _keyboard_worker(self):
        try:
            import evdev
            from evdev import ecodes
        except ImportError:
            sys.stderr.write("[knot-stripd] evdev not available, keyboard listener disabled\n")
            return

        last_toggle = 0.0
        while not self._stop_event.is_set():
            devices = []
            try:
                for path in evdev.list_devices():
                    try:
                        dev = evdev.InputDevice(path)
                        caps = dev.capabilities().get(ecodes.EV_KEY, [])
                        if ecodes.KEY_SCROLLLOCK in caps:
                            devices.append(dev)
                        else:
                            dev.close()
                    except Exception as e:
                        sys.stderr.write(f"[knot-stripd] Notice: Error inspecting device capabilities: {e}\n")
            except Exception as e:
                sys.stderr.write(f"[knot-stripd] Failed to list input devices: {e}\n")

            if not devices:
                time.sleep(2)
                continue

            try:
                while not self._stop_event.is_set():
                    r, _, _ = select.select(devices, [], [], 1.0)
                    for dev in r:
                        try:
                            for event in dev.read():
                                if event.type == ecodes.EV_KEY and event.code == ecodes.KEY_SCROLLLOCK and event.value == 1:
                                    now = time.time()
                                    if now - last_toggle > 0.4:
                                        last_toggle = now
                                        if self.is_local_anchor(self.active_screen):
                                            knot_bin = shutil.which("knot") or os.path.abspath(os.path.join(os.path.dirname(__file__), "knot"))
                                            subprocess.Popen([knot_bin, "kvm", "lock-toggle"])
                                        else:
                                            sys.stderr.write(f"[knot-stripd] ScrollLock ignored; cursor on remote screen '{self.active_screen}'\n")
                        except OSError:
                            raise
            except Exception as e:
                sys.stderr.write(f"[knot-stripd] Notice: Exception during device select/read loop: {e}\n")
                for d in devices:
                    try:
                        d.close()
                    except Exception as de:
                        sys.stderr.write(f"[knot-stripd] Notice: Error closing device: {de}\n")
                time.sleep(1)

    def _journal_worker(self):
        cmd = ["journalctl", "--user-unit=knot-deskflow.service", "-f", "-n", "0", "-o", "cat"]
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
            while not self._stop_event.is_set():
                line = proc.stdout.readline()
                if not line:
                    break

                # Connection event
                m_conn = re.search(r'client "([^"]+)" has connected', line)
                if m_conn:
                    cname = m_conn.group(1)
                    for ctrl in self.controllers:
                        if ctrl.matches_name(cname):
                            ctrl.set_connected(True)

                # Disconnection event
                m_dis = re.search(r'client "([^"]+)" (?:has disconnected|is dead)', line)
                if m_dis:
                    cname = m_dis.group(1)
                    for ctrl in self.controllers:
                        if ctrl.matches_name(cname):
                            ctrl.set_connected(False)

                # Cursor crossover triggers & active screen tracking
                m_switch = re.search(r'switch from "([^"]+)" to "([^"]+)"', line)
                if m_switch:
                    src, dst = m_switch.group(1), m_switch.group(2)
                    self.active_screen = dst
                    for ctrl in self.controllers:
                        if ctrl.matches_name(dst):
                            ctrl.trigger_crossover()
                        elif ctrl.matches_name(src) and self.is_local_anchor(dst):
                            ctrl.trigger_crossover()
                elif 'started server' in line or 'resetting server' in line:
                    self.active_screen = self.local_hostname
        except Exception as e:
            sys.stderr.write(f"[knot-stripd] Journal reader error: {e}\n")

def generate_qml_for_edge(edge: str, span: List[int]) -> str:
    direction = edge.lower().strip()
    s0 = span[0] if len(span) > 0 else 0
    s1 = span[1] if len(span) > 1 else 100
    if s1 <= s0:
        s0, s1 = 0, 100

    pct_span = (s1 - s0) / 100.0
    pct_start = s0 / 100.0

    if direction == "left":
        anchors = "LayerShell.Window.AnchorLeft | LayerShell.Window.AnchorTop"
        margins = f"LayerShell.Window.margins.top: Math.round(Screen.height * {pct_start})"
        width_expr = "stripItem.thickness"
        height_expr = f"Math.round(Screen.height * {pct_span})"
        orientation = "Gradient.Vertical"
    elif direction == "right":
        anchors = "LayerShell.Window.AnchorRight | LayerShell.Window.AnchorTop"
        margins = f"LayerShell.Window.margins.top: Math.round(Screen.height * {pct_start})"
        width_expr = "stripItem.thickness"
        height_expr = f"Math.round(Screen.height * {pct_span})"
        orientation = "Gradient.Vertical"
    elif direction in ("down", "bottom"):
        anchors = "LayerShell.Window.AnchorBottom | LayerShell.Window.AnchorLeft"
        margins = f"LayerShell.Window.margins.left: Math.round(Screen.width * {pct_start})"
        width_expr = f"Math.round(Screen.width * {pct_span})"
        height_expr = "stripItem.thickness"
        orientation = "Gradient.Horizontal"
    elif direction in ("up", "top"):
        anchors = "LayerShell.Window.AnchorTop | LayerShell.Window.AnchorLeft"
        margins = f"LayerShell.Window.margins.left: Math.round(Screen.width * {pct_start})"
        width_expr = f"Math.round(Screen.width * {pct_span})"
        height_expr = "stripItem.thickness"
        orientation = "Gradient.Horizontal"
    else:
        raise ValueError(f"Unknown edge direction: {edge}")

    content = QML_TEMPLATE.replace("__ANCHORS__", anchors)
    content = content.replace("__MARGINS__", margins)
    content = content.replace("__WIDTH__", width_expr)
    content = content.replace("__HEIGHT__", height_expr)
    content = content.replace("__ORIENTATION__", orientation)
    return content

def main():
    app = QGuiApplication(sys.argv)
    app.setApplicationName("knot-stripd")

    engine_mode = "journal"
    swarm_name = None
    for arg in sys.argv[1:]:
        if arg.startswith("--engine="):
            engine_mode = arg.split("=", 1)[1]
        elif arg.startswith("--swarm="):
            swarm_name = arg.split("=", 1)[1]

    daemon = KnotStripDaemon(swarm_name=swarm_name, engine_mode=engine_mode)
    if not daemon.controllers:
        sys.stderr.write("[knot-stripd] No edge controllers configured for current topology; daemon standing by\n")

    engine = QQmlApplicationEngine()
    windows = []

    for ctrl in daemon.controllers:
        try:
            qml_str = generate_qml_for_edge(ctrl.edge, ctrl.span)
            comp = QQmlComponent(engine)
            comp.setData(qml_str.encode("utf-8"), QUrl())
            if comp.isError():
                for err in comp.errors():
                    sys.stderr.write(f"[knot-stripd] QML Error ({ctrl.edge}): {err.toString()}\n")
                continue

            ctx = QQmlContext(engine.rootContext())
            ctx.setContextProperty("controller", ctrl)
            win = comp.create(ctx)
            if win:
                windows.append((win, ctx))
            else:
                sys.stderr.write(f"[knot-stripd] Failed to create window for edge {ctrl.edge}\n")
        except Exception as e:
            sys.stderr.write(f"[knot-stripd] Error initializing edge {ctrl.edge}: {e}\n")

    daemon.start_engine()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
