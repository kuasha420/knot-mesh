#!/usr/bin/env bash
set -euo pipefail

# Knot - Multi-Device Mesh Orchestrator CLI

KNOT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
KNOT_VERSION="${KNOT_VERSION:-1.0.0-rc4}"
source "$KNOT_ROOT/core/lib.sh"
source "$KNOT_ROOT/core/gitops.sh"
source "$KNOT_ROOT/core/modules/ssh.sh"
source "$KNOT_ROOT/core/modules/firewall.sh"
source "$KNOT_ROOT/core/modules/sudo.sh"
source "$KNOT_ROOT/core/modules/guard.sh"
source "$KNOT_ROOT/core/modules/mdns.sh"
source "$KNOT_ROOT/core/modules/deskflow.sh"
source "$KNOT_ROOT/core/modules/autounlock.sh"
source "$KNOT_ROOT/core/modules/autologin.sh"
source "$KNOT_ROOT/core/modules/kdeconnect.sh"
source "$KNOT_ROOT/core/modules/doctor.sh"
source "$KNOT_ROOT/core/modules/antigravity.sh"
source "$KNOT_ROOT/core/modules/hub.sh"
source "$KNOT_ROOT/core/modules/memory.sh"
source "$KNOT_ROOT/core/modules/shutdown.sh"
source "$KNOT_ROOT/core/modules/topology.sh"
source "$KNOT_ROOT/core/modules/swarm_sync.sh"
source "$KNOT_ROOT/core/modules/council.sh"

cmd_onboard() {
  local node_id="${1:-}"
  if [ -z "$node_id" ]; then
    local default_host
    default_host="$(knot_detect_hostname)"
    node_id="$default_host"
  fi

  knot_log_info "Onboarding node '$node_id' into Knot mesh..."

  ssh_ensure_local_key
  firewall_configure
  sudo_configure
  ssh_harden_server
  guard_configure
  mdns_configure
  autologin_ensure_dm
  antigravity_onboard

  local user
  user="$(knot_detect_user)"
  local host
  host="$(knot_detect_hostname)"
  local home
  home="$(knot_detect_user_home)"
  local pubkey
  pubkey="$(cat "$home/.ssh/id_ed25519.pub" | tr -d '\n')"
  local subnet
  subnet="$(knot_detect_subnet)"
  local gw_mac
  local ssh_port
  ssh_port="$(knot_detect_sshd_port)"
  local ip_hint=""
  local ip_out
  if ip_out="$(ip -4 -o addr show)"; then
    ip_hint="$(echo "$ip_out" | grep -v ' 127\.' | grep -v 'docker' | grep -v 'virbr' | grep -v 'waydroid' | awk '{print $4}' | cut -d/ -f1 | head -n1)"
  fi

  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local nodes_dir=""
  if ! nodes_dir="$(knot_get_nodes_dir)"; then
    local home
    home="$(knot_detect_user_home)"
    nodes_dir="$home/.config/knot/swarms/${active_swarm:-home}/nodes"
  fi
  mkdir -p "$nodes_dir"
  local manifest="$nodes_dir/${node_id}.json"

  local iface_json=""
  local first=1
  while IFS='|' read -r iface type mac ip; do
    [ -n "$iface" ] || continue
    if [ $first -eq 0 ]; then iface_json+=", "; fi
    iface_json+="\"$iface\": {\"type\": \"$type\", \"mac\": \"$mac\", \"ip\": \"$ip\"}"
    first=0
  done < <(knot_detect_network_interfaces)

  cat << JSON_EOF > "$manifest"
{
  "id": "$node_id",
  "hostname": "$host",
  "user": "$user",
  "port": $ssh_port,
  "mdns": "${host}.local",
  "ip_hint": "$ip_hint",
  "subnet": "$subnet",
  "gateway_mac": "$gw_mac",
  "interfaces": { $iface_json },
  "pubkey": "$pubkey"
}
JSON_EOF

  knot_log_ok "Node manifest registered at $manifest"

  cmd_sync

  knot_log_ok "Node '$node_id' successfully onboarded into Knot!"
}

cmd_sync() {
  local target="${1:-}"

  local my_host
  my_host="$(knot_detect_hostname)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_id="desktop"
  local anchor_host="desktop"

  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if [ "$my_host" = "$anchor_host" ] || [ "$my_host" = "$anchor_id" ]; then
    is_anchor=1
  else
    local nodes_dir=""
    if nodes_dir="$(knot_get_nodes_dir)"; then
      if [ -f "$nodes_dir/${my_host}.json" ] && grep -q '"role":[[:space:]]*"anchor"' "$nodes_dir/${my_host}.json"; then
        is_anchor=1
      fi
    fi
  fi

  if [ "$is_anchor" -eq 1 ]; then
    # Running on Anchor Workstation
    if [ "$target" = "--all" ]; then
      knot_log_info "Synchronizing Knot mesh across local system ($my_host)..."
      ssh_sync_authorized_keys
      ssh_sync_client_config
      deskflow_configure
      kdeconnect_sync_mesh
      knot_log_ok "Local Anchor configuration synchronized."

      local nodes_dir=""
      if ! nodes_dir="$(knot_get_nodes_dir)"; then
        knot_log_err "No nodes directory found for active swarm '$active_swarm'"
        return 1
      fi

      local topo_file=""
      local user_home
      user_home="$(knot_detect_user_home)"
      if [ -r "$user_home/.config/knot/swarms/${active_swarm}/topology.json" ]; then
        topo_file="$user_home/.config/knot/swarms/${active_swarm}/topology.json"
      elif [ -r "/etc/knot/swarms.d/${active_swarm}/topology.json" ]; then
        topo_file="/etc/knot/swarms.d/${active_swarm}/topology.json"
      fi

      local swarm_conf=""
      if [ -r "/etc/knot/swarms.d/${active_swarm}.conf" ]; then
        swarm_conf="/etc/knot/swarms.d/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}/swarm.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}/swarm.conf"
      fi

      local sync_count=0
      for manifest in "$nodes_dir/"*.json; do
        [ -e "$manifest" ] || continue
        local id host role
        id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        role="$(awk -F'"' '/"role":/ {print $4}' "$manifest")"

        if [ "$id" = "$anchor_id" ] || [ "$host" = "$anchor_host" ] || [ "$id" = "$my_host" ] || [ "$host" = "$my_host" ] || [ "$role" = "anchor" ]; then
          continue
        fi

        swarm_sync_anchor_push "$id" "$active_swarm" "$nodes_dir" "$topo_file" "$swarm_conf"
        sync_count=$((sync_count + 1))
      done
      knot_log_ok "Mesh-wide swarm synchronization complete ($sync_count Strands updated)."
    elif [ -n "$target" ] && [ "$target" != "$my_host" ] && [ "$target" != "$anchor_id" ] && [ "$target" != "local" ] && [ "$target" != "localhost" ]; then
      # Targeted Strand sync from Anchor
      local nodes_dir=""
      if ! nodes_dir="$(knot_get_nodes_dir)"; then
        knot_log_err "No nodes directory found for active swarm '$active_swarm'"
        return 1
      fi

      local topo_file=""
      local user_home
      user_home="$(knot_detect_user_home)"
      if [ -r "$user_home/.config/knot/swarms/${active_swarm}/topology.json" ]; then
        topo_file="$user_home/.config/knot/swarms/${active_swarm}/topology.json"
      elif [ -r "/etc/knot/swarms.d/${active_swarm}/topology.json" ]; then
        topo_file="/etc/knot/swarms.d/${active_swarm}/topology.json"
      fi

      local swarm_conf=""
      if [ -r "/etc/knot/swarms.d/${active_swarm}.conf" ]; then
        swarm_conf="/etc/knot/swarms.d/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}/swarm.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}/swarm.conf"
      fi

      swarm_sync_anchor_push "$target" "$active_swarm" "$nodes_dir" "$topo_file" "$swarm_conf"
      knot_log_ok "Swarm synchronization to Strand '$target' complete."
    else
      # Local sync only on Anchor
      knot_log_info "Synchronizing Knot mesh across local system ($my_host)..."
      ssh_sync_authorized_keys
      ssh_sync_client_config
      deskflow_configure
      kdeconnect_sync_mesh
      knot_log_ok "Knot mesh synchronization complete."
    fi
  else
    # Running locally on Strand
    if [ -n "$target" ] && [ "$target" != "--all" ] && [ "$target" != "$my_host" ] && [ "$target" != "local" ] && [ "$target" != "localhost" ]; then
      knot_log_warn "Notice: Device '$my_host' is a Strand. Multi-node distribution is orchestrated by the Anchor ($anchor_host)."
    fi
    swarm_sync_strand_pull
  fi
}

cmd_resolve() {
  exec "$KNOT_ROOT/core/resolver.sh" "$@"
}

cmd_status() {
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  echo -e "${C_BOLD}--- Knot Mesh Status (${active_swarm:-standalone}) ---${C_RESET}"
  printf "%-12s %-10s %-6s %-16s %-8s %-8s %-20s\n" "NODE" "USER" "PORT" "LAST IP" "MESH" "PING" "KVM STATUS"
  printf "%-12s %-10s %-6s %-16s %-8s %-8s %-20s\n" "----" "----" "----" "-------" "----" "----" "----------"

  local nodes_dir=""
  if ! nodes_dir="$(knot_get_nodes_dir)"; then
    nodes_dir=""
  fi

  local my_host
  my_host="$(knot_detect_hostname)"
  local anchor_id="desktop"
  local anchor_host="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  elif [ -n "$nodes_dir" ] && [ -d "$nodes_dir" ]; then
    for manifest in "$nodes_dir/"*.json; do
      [ -e "$manifest" ] || continue
      if grep -q '"role":[[:space:]]*"anchor"' "$manifest"; then
        anchor_id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        anchor_host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        break
      fi
    done
  fi

  local established_kvm_ips=""
  if [ "$my_host" = "$anchor_host" ] || [ "$my_host" = "$anchor_id" ]; then
    local ss_out=""
    if ss_out="$(ss -H -tn state established sport = :24800 2>&1)"; then
      established_kvm_ips="$(echo "$ss_out" | awk '{print $4}' | cut -d: -f1)"
    fi
  else
    local ssh_ss_out=""
    if ssh_ss_out="$(ssh -o BatchMode=yes -o ConnectTimeout=2 "$anchor_id" "ss -H -tn state established sport = :24800" 2>&1)"; then
      established_kvm_ips="$(echo "$ssh_ss_out" | awk '{print $4}' | cut -d: -f1)"
    fi
  fi

  if [ -n "$nodes_dir" ] && [ -d "$nodes_dir" ]; then
    for manifest in "$nodes_dir/"*.json; do
      [ -e "$manifest" ] || continue
      local id user ip_hint port host
      id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
      user="$(awk -F'"' '/"user":/ {print $4}' "$manifest")"
      host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
      ip_hint="$(awk -F'"' '/"ip_hint":/ {print $4}' "$manifest")"
      port="$(awk -F: '/"port":/ {gsub(/[^0-9]/, "", $2); print $2}' "$manifest")"
      if [ -z "$port" ]; then port="22"; fi

      local resolved_ip=""
      if ! resolved_ip="$("$KNOT_ROOT/core/resolver.sh" "$id" "$port")"; then
        resolved_ip=""
      fi

      if [ -n "$resolved_ip" ]; then
        local ping_time="ok"
        local ping_out=""
        if ping_out="$(ping -c 1 -W 1 "$resolved_ip" 2>&1)"; then
          local rtt
          rtt="$(echo "$ping_out" | awk -F'/' '/rtt/ {print $5}')"
          if [ -n "$rtt" ]; then
            ping_time="${rtt%.*}ms"
          fi
        fi

        local kvm_status="${C_YELLOW}DISCONNECTED${C_RESET}"
        if [ "$id" = "$anchor_id" ] || [ "$host" = "$anchor_host" ]; then
          local count=0
          if [ -n "$established_kvm_ips" ]; then
            count="$(echo "$established_kvm_ips" | grep -v '^$' | wc -l)"
          fi
          kvm_status="${C_GREEN}SERVER ($count connected)${C_RESET}"
        else
          if [ -n "$established_kvm_ips" ] && echo "$established_kvm_ips" | grep -q "$resolved_ip"; then
            kvm_status="${C_GREEN}CONNECTED${C_RESET}"
          else
            kvm_status="${C_YELLOW}DISCONNECTED${C_RESET}"
          fi
        fi

        printf "%-12s %-10s %-6s %-16s ${C_GREEN}%-8s${C_RESET} %-8s %-20b\n" "$id" "$user" "$port" "$resolved_ip" "ONLINE" "$ping_time" "$kvm_status"
      else
        printf "%-12s %-10s %-6s %-16s ${C_RED}%-8s${C_RESET} %-8s %-20b\n" "$id" "$user" "$port" "${ip_hint:-(unknown)}" "OFFLINE" "-" "${C_RED}OFFLINE${C_RESET}"
      fi
    done
  fi
}


cmd_exec() {
  local tty_opts=()
  if [ "${1:-}" = "-t" ] || [ "${1:-}" = "-tt" ]; then
    tty_opts=(-t)
    shift
  fi
  local target="${1:-}"
  [ $# -gt 0 ] && shift
  local cmd="$*"

  if [ -z "$target" ] || [ -z "$cmd" ]; then
    knot_log_err "Usage: knot exec [-t] <node_id|--all> <command>"
    exit 1
  fi

  local remote_cmd="export PATH=\"\$HOME/.local/bin:\$PATH\"; $cmd"

  if [ "$target" = "--all" ]; then
    local nodes_dir=""
    if ! nodes_dir="$(knot_get_nodes_dir)"; then
      knot_log_warn "No active swarm nodes directory found."
      return 1
    fi
    local my_host
    my_host="$(knot_detect_hostname)"
    for manifest in "$nodes_dir/"*.json; do
      [ -e "$manifest" ] || continue
      local id host
      id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
      host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
      echo -e "\n${C_CYAN}=== [$id] ===${C_RESET}"
      local e_out=""
      if [ "$id" = "$my_host" ] || [ "$host" = "$my_host" ]; then
        if e_out="$(bash -c "$remote_cmd" 2>&1)"; then
          echo "$e_out"
        else
          knot_log_warn "Notice: Command failed locally on $id: $e_out"
        fi
      elif e_out="$(ssh -o BatchMode=yes -o ConnectTimeout=3 "$id" "$remote_cmd" 2>&1)"; then
        echo "$e_out"
      else
        knot_log_warn "Notice: Command failed on $id: $e_out"
      fi
    done
  else
    local my_host
    my_host="$(knot_detect_hostname)"
    local nodes_dir=""
    nodes_dir="$(knot_get_nodes_dir 2>/dev/null || true)"
    local is_local=0
    if [ "$target" = "$my_host" ] || [ "$target" = "local" ] || [ "$target" = "localhost" ]; then
      is_local=1
    elif [ -n "$nodes_dir" ] && [ -f "$nodes_dir/${target}.json" ]; then
      local t_host
      t_host="$(awk -F'"' '/"hostname":/ {print $4}' "$nodes_dir/${target}.json")"
      if [ "$t_host" = "$my_host" ]; then
        is_local=1
      fi
    fi
    if [ "$is_local" -eq 1 ]; then
      bash -c "$remote_cmd"
    else
      if [ ${#tty_opts[@]} -gt 0 ]; then
        ssh "${tty_opts[@]}" -o ConnectTimeout=5 "$target" "$remote_cmd"
      else
        ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" "$remote_cmd"
      fi
    fi
  fi
}

cmd_kvm() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  local my_host
  my_host="$(knot_detect_hostname)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_host="desktop"
  local anchor_id="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if knot_is_anchor; then
    is_anchor=1
  fi

  case "$action" in
    restart)
      knot_log_info "Restarting Deskflow KVM across the Knot mesh..."

      if [ "$is_anchor" -eq 1 ]; then
        knot_log_info "Restarting KVM Server locally on Anchor ($anchor_host)..."
        systemctl --user restart knot-deskflow
        sleep 1.5

        local nodes_dir=""
        if ! nodes_dir="$(knot_get_nodes_dir)"; then
          local home
          home="$(knot_detect_user_home)"
          if [ -d "$home/.config/knot/swarms/${active_swarm}/nodes" ]; then
            nodes_dir="$home/.config/knot/swarms/${active_swarm}/nodes"
          fi
        fi

        if [ -n "$nodes_dir" ]; then
          for manifest in "$nodes_dir/"*.json; do
            [ -e "$manifest" ] || continue
            local id host
            id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
            host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
            if [ -n "$id" ] && [ "$id" != "$anchor_id" ] && [ "$host" != "$anchor_host" ]; then
              knot_log_info "Restarting KVM Client remotely on $id ($host)..."
              local r_out
              if r_out="$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$id" "systemctl --user restart knot-deskflow" 2>&1)"; then
                :
              else
                knot_log_warn "Notice: Could not restart KVM remotely on $id: $r_out"
              fi
            fi
          done
        fi
      else
        knot_log_info "Restarting KVM Client locally on Strand ($my_host)..."
        systemctl --user restart knot-deskflow
      fi

      sleep 1
      knot_log_ok "Deskflow KVM restarted."
      ;;
    lock)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      deskflow_set_lock "locked"
      ;;
    unlock)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      deskflow_set_lock "unlocked"
      ;;
    lock-toggle|toggle-lock)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      deskflow_set_lock "toggle"
      ;;
    status)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      local lock_status
      lock_status="$(deskflow_get_lock)"
      if [ "$lock_status" = "locked" ]; then
        knot_log_warn "KVM Cursor Lock: LOCKED (host confined to desktop)"
      else
        knot_log_ok "KVM Cursor Lock: UNLOCKED (multi-screen crossover active)"
      fi

      local my_host
      my_host="$(knot_detect_hostname)"
      local established=""
      if [ "$my_host" = "$anchor_host" ]; then
        local ss_out
        if ss_out="$(ss -H -tn state established sport = :24800)"; then
          established="$(echo "$ss_out" | awk '{print $4}' | cut -d: -f1)"
        fi
      else
        local ssh_ss_out
        if ssh_ss_out="$(ssh -o BatchMode=yes -o ConnectTimeout=2 desktop "ss -H -tn state established sport = :24800")"; then
          established="$(echo "$ssh_ss_out" | awk '{print $4}' | cut -d: -f1)"
        fi
      fi
      local count=0
      if [ -n "$established" ]; then
        count="$(echo "$established" | grep -v '^$' | wc -l)"
      fi
      knot_log_info "Established KVM Sockets on Anchor: $count client(s) connected"
      for ip in $established; do
        echo -e "  -> $ip connected"
      done

      knot_log_info "Deskflow KVM service status across the mesh:"
      cmd_exec --all "systemctl --user show knot-deskflow -p ActiveState,SubState --value | tr '\n' ' '; echo"
      knot_log_info "KVM Auto-Unlock daemon status across the mesh:"
      cmd_exec --all "systemctl --user show knot-autounlock -p ActiveState,SubState --value | tr '\n' ' '; echo"
      ;;
    *)
      echo "Usage: knot kvm <restart|status|lock|unlock|lock-toggle>"
      ;;
  esac
}

cmd_doctor() {
  doctor_diagnose "$@"
}

cmd_repair() {
  doctor_repair "$@"
}

cmd_council() {
  local action="${1:-start}"
  if [ $# -gt 0 ]; then shift; fi

  case "$action" in
    start) council_start "$@" ;;
    status) council_status "$@" ;;
    reply) council_reply "$@" ;;
    list) council_list "$@" ;;
    attach) council_attach "$@" ;;
    reconcile) council_reconcile "$@" ;;
    copy) council_copy "$@" ;;
    clean) council_clean "$@" ;;
    kill) council_kill "$@" ;;
    audit) bash "$KNOT_ROOT/skills/swarm-council/scripts/audit_tools.sh" "$@" ;;
    sync) bash "$KNOT_ROOT/skills/swarm-council/scripts/project_sync.sh" "$@" ;;
    *)
      echo "Usage: knot council <start|status|reply|list|attach|reconcile|copy|clean|kill|audit|sync> [options]"
      ;;
  esac
}

cmd_color() {
  python3 "$KNOT_ROOT/core/palette.py" "$@"
}

cmd_swarm() {
  local action="${1:-status}"
  if [ $# -gt 0 ]; then shift; fi

  case "$action" in
    switch|use)
      local target_swarm="${1:-}"
      if [ -z "$target_swarm" ]; then
        knot_log_err "Usage: knot swarm switch <swarm_id>"
        exit 1
      fi

      local user_home
      user_home="$(knot_detect_user_home)"
      local profile_found=0
      local profile_path=""

      if [ -r "/etc/knot/swarms.d/${target_swarm}.conf" ]; then
        profile_found=1
        profile_path="/etc/knot/swarms.d/${target_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${target_swarm}/swarm.conf" ]; then
        profile_found=1
        profile_path="$user_home/.config/knot/swarms/${target_swarm}/swarm.conf"
      elif [ -r "$user_home/.config/knot/swarms/${target_swarm}.conf" ]; then
        profile_found=1
        profile_path="$user_home/.config/knot/swarms/${target_swarm}.conf"
      fi

      if [ "$profile_found" -eq 0 ]; then
        knot_log_err "Swarm profile for '$target_swarm' not found in /etc/knot/swarms.d/${target_swarm}.conf or ~/.config/knot/swarms/${target_swarm}/swarm.conf"
        exit 1
      fi

      knot_set_active_swarm "$target_swarm"
      knot_log_ok "Switched active swarm to '$target_swarm'."

      local my_host
      my_host="$(knot_detect_hostname)"
      local anchor_id="desktop"
      local anchor_host="desktop.local"

      if [ -n "$profile_path" ]; then
        local a_id a_host
        a_id="$(awk -F= '/^ANCHOR_ID=/ {print $2}' "$profile_path" | tr -d '"'\'' ')"
        a_host="$(awk -F= '/^ANCHOR_HOST=/ {print $2}' "$profile_path" | tr -d '"'\'' ')"
        [ -n "$a_id" ] && anchor_id="$a_id"
        [ -n "$a_host" ] && anchor_host="$a_host"
      fi

      local is_anchor=0
      if [ "$my_host" = "$anchor_host" ] || [ "$my_host" = "$anchor_id" ]; then
        is_anchor=1
      else
        local nodes_dir=""
        if [ -d "$user_home/.config/knot/swarms/${target_swarm}/nodes" ]; then
          nodes_dir="$user_home/.config/knot/swarms/${target_swarm}/nodes"
        elif [ -d "/etc/knot/swarms.d/${target_swarm}/nodes" ]; then
          nodes_dir="/etc/knot/swarms.d/${target_swarm}/nodes"
        fi
        if [ -n "$nodes_dir" ] && [ -r "$nodes_dir/${anchor_id}.json" ]; then
          local m_host
          m_host="$(awk -F'"' '/"hostname":/ {print $4}' "$nodes_dir/${anchor_id}.json")"
          if [ "$m_host" = "$my_host" ] || grep -q "\"$my_host\"" "$nodes_dir/${anchor_id}.json"; then
            is_anchor=1
          fi
        fi
      fi

      if [ "$is_anchor" -eq 1 ]; then
        knot_log_info "Node '$my_host' is ANCHOR in swarm '$target_swarm'. Recompiling Deskflow server configuration..."
        deskflow_write_server_conf
      else
        knot_log_info "Node '$my_host' is STRAND in swarm '$target_swarm'. Recompiling Deskflow client configuration..."
        deskflow_write_client_conf
      fi

      if command -v systemctl >/dev/null; then
        local d_out="" s_out=""
        if d_out="$(systemctl --user restart knot-deskflow.service 2>&1)"; then
          knot_log_ok "Restarted knot-deskflow service."
        else
          knot_log_warn "Notice: knot-deskflow restart: $d_out"
        fi

        if s_out="$(systemctl --user restart knot-stripd.service 2>&1)"; then
          knot_log_ok "Restarted knot-stripd service."
        else
          knot_log_warn "Notice: knot-stripd restart: $s_out"
        fi
      fi
      ;;
    status)
      antigravity_swarm_status
      ;;
    quota)
      antigravity_swarm_quota "$@"
      ;;
    test)
      antigravity_swarm_test "$@"
      ;;
    exec)
      if [ $# -lt 2 ]; then
        knot_log_err "Usage: knot swarm exec <node> \"<prompt>\" [extra_flags]"
        exit 1
      fi
      local target="$1"
      local prompt="$2"
      shift 2
      antigravity_exec_node "$target" "$prompt" "$@"
      ;;
    auth)
      antigravity_swarm_auth "$@"
      ;;
    color|colors|palette)
      cmd_color "$@"
      ;;
    *)
      echo "Usage: knot swarm <status|quota [node|--all]|auth [node|--gui]|color [node]|test [node|--all]|exec <node> \"<prompt>\">"
      exit 1
      ;;
  esac
}


cmd_kdeconnect() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  case "$action" in
    sync)
      if [ "${1:-}" = "--all" ]; then
        knot_log_info "Synchronizing KDE Connect & enforcing clipboard sharing across the entire mesh..."
        cmd_exec --all "knot kdeconnect sync"
      else
        kdeconnect_sync_mesh
      fi
      ;;
    status)
      knot_log_info "KDE Connect status across the mesh:"
      cmd_exec --all "kdeconnect-cli -a"
      ;;
    *)
      echo "Usage: knot kdeconnect <status|sync [--all]>"
      ;;
  esac
}

cmd_autologin() {
  local action="${1:-check}"
  [ $# -gt 0 ] && shift

  case "$action" in
    check)
      autologin_execute_local
      ;;
    local)
      autologin_execute_local
      ;;
    status)
      local state
      state="$(autologin_anchor_status)"
      if [ "$state" = "UNLOCKED" ]; then
        knot_log_ok "Anchor desktop state: UNLOCKED (ready for Strand login)"
      elif [ "$state" = "LOCKED" ]; then
        knot_log_warn "Anchor desktop state: LOCKED (Strand login gated)"
      else
        knot_log_err "Anchor desktop state: OFFLINE"
      fi
      ;;
    reconcile)
      autologin_reconcile_all
      ;;
    migrate-dm|ensure-dm)
      autologin_ensure_dm
      ;;
    fix-kwallet|kwallet)
      autologin_fix_kwallet "$@"
      ;;
    *)
      autologin_trigger_remote "$action"
      ;;
  esac
}

cmd_screen() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  case "$action" in
    status)
      screen_status "$@"
      ;;
    status-raw)
      screen_status_raw
      ;;
    unlock)
      screen_unlock "$@"
      ;;
    lock)
      screen_lock "$@"
      ;;
    login)
      screen_login "$@"
      ;;
    *)
      echo "Usage: knot screen <status|unlock|lock|login> [node|--all]"
      ;;
  esac
}

cmd_shutdown() {
  local target="local"
  local action="poweroff"
  local delay="now"
  local wall_msg="Graceful shutdown scheduled via Knot Swarm"
  local force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo -e "${C_BOLD}knot shutdown - Graceful Swarm-wide Shutdown & Reboot${C_RESET}"
        echo "Usage:"
        echo "  knot shutdown [target] [options]"
        echo ""
        echo "Targets:"
        echo "  local, desktop, laptop, steamdeck, or --all (default: local)"
        echo ""
        echo "Options:"
        echo "  -d, --delay <time>   Delay before shutdown (e.g. '5m', '10', '60s', 'now'; default: now)"
        echo "  -r, --reboot         Reboot instead of power off"
        echo "  -c, --cancel         Cancel scheduled shutdown on target(s)"
        echo "  -s, --show, status   Show scheduled shutdown status"
        echo "  -m, --msg <text>     Custom wall message broadcast to users"
        echo "  -f, --force, -y      Skip interactive confirmation prompt"
        echo ""
        echo "Examples:"
        echo "  knot shutdown laptop --delay 5m    Schedule laptop shutdown in 5 minutes"
        echo "  knot shutdown --all --reboot       Reboot all mesh nodes gracefully"
        echo "  knot shutdown --all --cancel       Cancel scheduled shutdowns across swarm"
        echo "  knot shutdown --all status         Inspect pending shutdowns across swarm"
        return 0
        ;;
      -r|--reboot)
        action="reboot"
        shift
        ;;
      -c|--cancel)
        action="cancel"
        shift
        ;;
      -s|--show|status)
        action="show"
        shift
        ;;
      -d|--delay)
        delay="$2"
        shift 2
        ;;
      -m|--msg)
        wall_msg="$2"
        shift 2
        ;;
      --action)
        action="$2"
        shift 2
        ;;
      -f|--force|-y|--yes)
        force=1
        shift
        ;;
      --all)
        target="--all"
        shift
        ;;
      local|desktop|laptop|steamdeck)
        target="$1"
        shift
        ;;
      *)
        if [[ "$1" =~ ^- ]]; then
          knot_log_err "Unknown shutdown option: $1"
          return 1
        else
          target="$1"
          shift
        fi
        ;;
    esac
  done

  # If action is poweroff or reboot, and not forced, ask confirmation
  if [ "$action" != "cancel" ] && [ "$action" != "show" ] && [ $force -eq 0 ]; then
    echo -e "${C_YELLOW}${C_BOLD}[!] CONFIRMATION REQUIRED:${C_RESET}"
    echo -e "    Action: ${C_RED}${action^^}${C_RESET}"
    echo -e "    Target: ${C_BOLD}${target}${C_RESET}"
    echo -e "    Delay:  ${C_BOLD}${delay}${C_RESET}"
    read -r -p "    Are you sure you want to proceed? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
      knot_log_info "Operation cancelled by user."
      return 0
    fi
  fi

  if [ "$target" = "--all" ]; then
    shutdown_exec_all "$action" "$delay" "$wall_msg"
  elif [ "$target" = "local" ]; then
    shutdown_exec_local "$action" "$delay" "$wall_msg"
  else
    shutdown_exec_remote "$target" "$action" "$delay" "$wall_msg"
  fi
}

cmd_mcp() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  case "$action" in
    sync)
      local target="${1:-local}"
      if [ "$target" = "--all" ] || [ "$target" = "all" ]; then
        knot_log_info "Synchronizing Knot MCP suite across all mesh nodes..."
        python3 "$KNOT_ROOT/core/mcp/sync.py"
        local nodes_dir=""
        if nodes_dir="$(knot_get_nodes_dir)"; then
          for manifest in "$nodes_dir/"*.json; do
            [ -e "$manifest" ] || continue
            local id host
            id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
            host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
            if [ "$host" != "$(knot_detect_hostname)" ] && [ "$id" != "desktop" ]; then
              knot_log_info "Synchronizing MCP on remote node: $id ($host)..."
              knot exec "$id" "python3 $KNOT_ROOT/core/mcp/sync.py" || knot_log_warn "Failed to sync MCP on $id"
            fi
          done
        fi
        knot_log_ok "Mesh-wide MCP synchronization complete."
      elif [ "$target" = "local" ] || [ "$target" = "$(knot_detect_hostname)" ]; then
        python3 "$KNOT_ROOT/core/mcp/sync.py"
      else
        knot_log_info "Synchronizing MCP on $target..."
        knot exec "$target" "python3 $KNOT_ROOT/core/mcp/sync.py"
      fi
      ;;
    test)
      python3 "$KNOT_ROOT/core/mcp/gateway.py" --test
      ;;
    list|status)
      echo -e "${C_BOLD}--- Knot MCP Gateway Tools ---${C_RESET}"
      python3 -c "
import sys; sys.path.insert(0, '$KNOT_ROOT')
from core.mcp.gateway import KnotMCPGateway, KnotHubClient
gw = KnotMCPGateway(KnotHubClient())
tools = gw._handle_tools_list({})['tools']
for i, t in enumerate(tools, 1):
    print(f'  {i:2d}. {t[\"name\"]:24s} - {t[\"description\"]}')
"
      ;;
    *)
      knot_log_err "Usage: knot mcp [sync [--all]|test|list]"
      exit 1
      ;;
  esac
}

cmd_update() {
  local target="local"
  local force=0
  local orig_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo -e "${C_BOLD}knot update - Swarm-Wide Binary & Module Updater${C_RESET}"
        echo "Usage:"
        echo "  knot update [options]               Check and update local node from GitHub release"
        echo "  knot update --all [options]         Anchor mode: Coordinated rollout across all active Strands"
        echo "  knot update <node_id> [options]     Roll out update to a specific mesh node"
        echo ""
        echo "Options:"
        echo "  -f, --force    Force reinstall/download even if version matches"
        echo "  -h, --help     Show this help message"
        return 0
        ;;
      -f|--force)
        force=1
        orig_args+=("$1")
        shift
        ;;
      --all)
        target="--all"
        orig_args+=("$1")
        shift
        ;;
      local)
        target="local"
        shift
        ;;
      *)
        target="$1"
        orig_args+=("$1")
        shift
        ;;
    esac
  done

  if [ "$target" = "local" ]; then
    local local_ver="${KNOT_VERSION:-1.0.0-rc3}"
    knot_log_info "Checking for latest Knot Mesh release (current: v${local_ver})..."

    local remote_tag=""
    if command -v gh >/dev/null; then
      local gh_out=""
      if gh_out="$(gh release view --json tagName -q .tagName 2>&1)"; then
        remote_tag="$(echo "$gh_out" | tr -d '[:space:]')"
      fi
    fi

    if [ -z "$remote_tag" ] && command -v curl >/dev/null; then
      local curl_out=""
      if curl_out="$(curl -sSfL -H "Accept: application/vnd.github+json" https://api.github.com/repos/kuasha420/knot-mesh/releases/latest 2>&1)"; then
        remote_tag="$(echo "$curl_out" | grep '"tag_name":' | head -n1 | cut -d '"' -f 4 | tr -d '[:space:]')"
      fi
    fi

    if [ -z "$remote_tag" ]; then
      knot_log_err "Failed to fetch latest release tag from GitHub."
      return 1
    fi

    local clean_remote="${remote_tag#v}"
    local clean_local="${local_ver#v}"

    if [ "$clean_remote" = "$clean_local" ] && [ $force -eq 0 ]; then
      knot_log_ok "Knot Mesh is up to date (${remote_tag})."
      return 0
    fi

    knot_log_info "Updating Knot Mesh: v${clean_local} -> ${remote_tag}..."

    local tmp_dir=""
    tmp_dir="$(mktemp -d)"
    local tarball="$tmp_dir/release.tar.gz"

    knot_log_info "Downloading release tarball (${remote_tag})..."
    local dl_url="https://github.com/kuasha420/knot-mesh/archive/refs/tags/${remote_tag}.tar.gz"
    local dl_err=""
    if ! dl_err="$(curl -sSfL "$dl_url" -o "$tarball" 2>&1)"; then
      knot_log_err "Failed to download release archive from $dl_url: $dl_err"
      rm -rf "$tmp_dir"
      return 1
    fi

    knot_log_info "Extracting release tarball..."
    local tar_err=""
    if ! tar_err="$(tar -xzf "$tarball" -C "$tmp_dir" 2>&1)"; then
      knot_log_err "Failed to extract release archive: $tar_err"
      rm -rf "$tmp_dir"
      return 1
    fi

    local extracted_root=""
    extracted_root="$(find "$tmp_dir" -mindepth 1 -maxdepth 1 -type d | head -n1)"
    if [ -z "$extracted_root" ] || [ ! -d "$extracted_root" ]; then
      knot_log_err "Failed to locate extracted release directory in $tmp_dir"
      rm -rf "$tmp_dir"
      return 1
    fi

    local user_home
    user_home="$(knot_detect_user_home)"
    local bin_dest="$user_home/.local/bin"
    mkdir -p "$bin_dest"

    local target_root="$KNOT_ROOT"
    if [ -d "$KNOT_ROOT/.git" ] && [ -d "$user_home/.local/share/knot-mesh" ]; then
      target_root="$user_home/.local/share/knot-mesh"
    elif [ ! -w "$target_root" ] || [ ! -d "$target_root/core" ]; then
      target_root="$user_home/.local/share/knot-mesh"
    fi
    mkdir -p "$target_root/bin" "$target_root/core"

    if [ -d "$extracted_root/core" ]; then
      knot_log_info "Installing core libraries to $target_root/core/..."
      cp -r "$extracted_root/core/"* "$target_root/core/"
      if [ "$target_root" != "$user_home/.local/share/knot-mesh" ] && [ -d "$user_home/.local/share/knot-mesh/core" ] && [ -w "$user_home/.local/share/knot-mesh/core" ]; then
        cp -r "$extracted_root/core/"* "$user_home/.local/share/knot-mesh/core/"
      fi
    fi

    if [ -d "$extracted_root/bin" ]; then
      knot_log_info "Installing binaries to $target_root/bin/ and $bin_dest/..."
      cp -r "$extracted_root/bin/"* "$target_root/bin/"
      chmod +x "$target_root/bin/"*
      for b in "$extracted_root/bin/"*; do
        [ -f "$b" ] || continue
        local b_name
        b_name="$(basename "$b")"
        if [ -L "$bin_dest/$b_name" ]; then
          local link_target
          link_target="$(readlink -f "$bin_dest/$b_name")"
          if [ -f "$link_target" ] && [ "$link_target" != "$extracted_root/bin/$b_name" ]; then
            if [[ "$link_target" != *"/Dev/"* ]] && [[ "$link_target" != *".git"* ]]; then
              cp -f "$b" "$link_target"
            fi
          fi
        else
          cp -f "$b" "$bin_dest/$b_name"
        fi
        chmod +x "$bin_dest/$b_name"
      done
    fi

    rm -rf "$tmp_dir"

    knot_log_info "Refreshing systemd services (preserving active KVM sessions)..."
    if systemctl --user is-active --quiet knot-agent.service; then
      systemctl --user restart knot-agent.service
      knot_log_ok "knot-agent.service restarted."
    fi
    if systemctl --user is-active --quiet knot-stripd.service; then
      systemctl --user restart knot-stripd.service
      knot_log_ok "knot-stripd.service restarted."
    fi

    knot_log_ok "Local Knot Mesh update complete (${remote_tag})."
    return 0
  fi

  local my_host
  my_host="$(knot_detect_hostname)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_id="desktop"
  local anchor_host="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if knot_is_anchor; then
    is_anchor=1
  fi

  # Prevent infinite delegation loop: if target anchor resolves to local host, we are the Anchor
  if [ "$anchor_id" = "$my_host" ] || [ "$anchor_host" = "$my_host" ]; then
    is_anchor=1
  fi

  # If run on a Strand, delegate to the Anchor
  if [ $is_anchor -eq 0 ]; then
    knot_log_info "Node '$my_host' is a Strand. Delegating fleet update to Anchor ($anchor_id)..."
    local remote_cmd="export PATH=\"\$HOME/.local/bin:\$PATH\"; knot update"
    if [ ${#orig_args[@]} -gt 0 ]; then
      remote_cmd="$remote_cmd ${orig_args[*]}"
    fi
    if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$anchor_id" "$remote_cmd"; then
      knot_log_err "Failed to execute update on Anchor ($anchor_id)"
      return 1
    fi
    return 0
  fi

  # We are on the Anchor
  local strands=()
  if [ "$target" = "--all" ]; then
    local nodes_dir=""
    if nodes_dir="$(knot_get_nodes_dir)"; then
      for manifest in "$nodes_dir/"*.json; do
        [ -e "$manifest" ] || continue
        local n_id n_role n_host
        n_id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        n_role="$(awk -F'"' '/"role":/ {print $4}' "$manifest")"
        n_host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        if [ "$n_role" = "anchor" ] || [ "$n_id" = "$anchor_id" ] || [ "$n_host" = "$anchor_host" ]; then
          continue
        fi
        if [ -n "$n_id" ]; then
          strands+=("$n_id")
        fi
      done
    fi
    if [ ${#strands[@]} -eq 0 ]; then
      strands=("laptop" "rog-ally" "steamdeck")
    fi
  else
    strands=("$target")
  fi

  knot_log_info "Anchor mode: Orchestrating rollout across strands: ${strands[*]}..."

  for strand in "${strands[@]}"; do
    echo -e "\n${C_CYAN}=== Rolling out update to Strand: [$strand] ===${C_RESET}"

    local probe_out=""
    if ! probe_out="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" "true" 2>&1)"; then
      knot_log_warn "Strand '$strand' is unreachable: $probe_out. Skipping."
      continue
    fi

    local strand_root=""
    strand_root="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" '
      if [ -L "$HOME/.local/bin/knot" ]; then
        p="$(readlink -f "$HOME/.local/bin/knot")"
        dirname "$(dirname "$p")"
      elif [ -d "$HOME/.local/share/knot-mesh" ]; then
        echo "$HOME/.local/share/knot-mesh"
      elif [ -d "$HOME/knot-mesh" ]; then
        echo "$HOME/knot-mesh"
      else
        echo "$HOME/.local/share/knot-mesh"
      fi
    ')"

    if [ -z "$strand_root" ]; then
      knot_log_err "Failed to determine Knot root directory on $strand"
      continue
    fi

    knot_log_info "Target root on $strand: $strand_root"

    ssh -o BatchMode=yes "$strand" "mkdir -p '$strand_root/bin' '$strand_root/core' \"\$HOME/.local/bin\""

    if ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" "command -v rsync >/dev/null" 2>&1; then
      knot_log_info "Syncing binaries to $strand:$strand_root/bin/..."
      rsync -az --exclude '__pycache__' "$KNOT_ROOT/bin/" "$strand:$strand_root/bin/"

      knot_log_info "Syncing core modules to $strand:$strand_root/core/..."
      rsync -az --exclude '__pycache__' "$KNOT_ROOT/core/" "$strand:$strand_root/core/"
    else
      knot_log_info "Syncing binaries and core modules to $strand:$strand_root/ via streaming tar fallback..."
      tar -czf - --exclude='__pycache__' -C "$KNOT_ROOT" bin core | ssh -o BatchMode=yes "$strand" "tar -xzf - -C '$strand_root'"
    fi

    ssh -o BatchMode=yes "$strand" "
      chmod +x '$strand_root/bin/'*
      for b in '$strand_root/bin/'*; do
        [ -f \"\$b\" ] || continue
        base=\"\$(basename \"\$b\")\"
        if [ ! -L \"\$HOME/.local/bin/\$base\" ] && [ ! -f \"\$HOME/.local/bin/\$base\" ]; then
          ln -sf \"\$b\" \"\$HOME/.local/bin/\$base\"
        elif [ -L \"\$HOME/.local/bin/\$base\" ]; then
          ln -sf \"\$b\" \"\$HOME/.local/bin/\$base\"
        fi
        chmod +x \"\$HOME/.local/bin/\$base\"
      done
    "

    knot_log_info "Restarting services on $strand without interrupting KVM..."
    ssh -o BatchMode=yes "$strand" '
      if systemctl --user is-active --quiet knot-agent.service; then
        systemctl --user restart knot-agent.service
        echo "  [✓] knot-agent.service restarted"
      fi
      if systemctl --user is-active --quiet knot-stripd.service; then
        systemctl --user restart knot-stripd.service
        echo "  [✓] knot-stripd.service restarted"
      fi
    '

    knot_log_ok "Strand '$strand' updated successfully."
  done

  knot_log_ok "Swarm-wide fleet rollout complete."
}

case "${1:-}" in
  update)
    shift
    cmd_update "$@"
    ;;
  -v|--version|version)
    echo "knot-mesh version ${KNOT_VERSION:-1.0.0-rc4}"
    ;;
  mcp)
    shift
    cmd_mcp "$@"
    ;;
  onboard)
    shift
    cmd_onboard "$@"
    ;;
  sync)
    shift
    cmd_sync "$@"
    ;;
  resolve)
    shift
    cmd_resolve "$@"
    ;;
  status)
    cmd_status
    ;;
  exec)
    shift
    cmd_exec "$@"
    ;;
  kvm)
    shift
    cmd_kvm "$@"
    ;;
  screen)
    shift
    cmd_screen "$@"
    ;;
  unlock)
    shift
    screen_unlock "$@"
    ;;
  lock)
    shift
    screen_lock "$@"
    ;;
  login)
    shift
    screen_login "$@"
    ;;
  autologin)
    shift
    cmd_autologin "$@"
    ;;
  kdeconnect)
    shift
    cmd_kdeconnect "$@"
    ;;
  council)
    shift
    cmd_council "$@"
    ;;
  swarm)
    shift
    cmd_swarm "$@"
    ;;
  color|palette)
    shift
    cmd_color "$@"
    ;;
  quota)
    shift
    cmd_swarm quota "$@"
    ;;
  auth)
    shift
    cmd_swarm auth "$@"
    ;;
  hub)
    shift
    cmd_hub "$@"
    ;;
  agent)
    shift
    cmd_agent "$@"
    ;;
  task)
    shift
    cmd_task "$@"
    ;;
  project)
    shift
    cmd_project "$@"
    ;;
  chat)
    shift
    cmd_chat "$@"
    ;;
  artifact)
    shift
    cmd_artifact "$@"
    ;;
  sleep|power)
    shift
    cmd_sleep "$@"
    ;;
  kafe|cockpit|web)
    shift
    cmd_web "$@"
    ;;
  memory)
    shift
    cmd_memory "$@"
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    ;;
  repair)
    shift
    cmd_repair "$@"
    ;;
  restart)
    shift
    if [ "${1:-}" = "kvm" ] || [ -z "${1:-}" ]; then
      cmd_kvm restart
    else
      knot_log_err "Unknown restart target: $1"
      exit 1
    fi
    ;;
  shutdown)
    shift
    cmd_shutdown "$@"
    ;;
  reboot)
    shift
    cmd_shutdown --reboot "$@"
    ;;
  topology)
    shift
    cmd_topology "$@"
    ;;
  *)
    echo -e "${C_BOLD}Knot - Multi-Device Mesh Orchestrator${C_RESET}"
    echo "Usage:"
    echo "  knot update [--all|<node_id>] Update Knot binaries & core modules from release/Anchor"
    echo "  knot topology [show|refresh]  Visual multi-screen spatial layout & photo refresh"
    echo "  knot onboard [node_id]        Enroll current device into the mesh"
    echo "  knot sync [--all | <node_id>] Reconcile keys, configs, and layout across swarm"
    echo "  knot resolve <node_id> [port] Resolve active IP across 3 tiers"
    echo "  knot status                   Show live status of all mesh nodes"
    echo "  knot council <start|status|reply|list|attach|reconcile|copy|clean|kill> Out-of-band multi-agent swarm coordination"
