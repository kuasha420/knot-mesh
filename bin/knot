#!/usr/bin/env bash
set -euo pipefail

# Knot - Multi-Device Mesh Orchestrator CLI

KNOT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
KNOT_VERSION="1.0.0-rc5"
source "$KNOT_ROOT/core/lib.sh"
source "$KNOT_ROOT/core/gitops.sh"
source "$KNOT_ROOT/core/modules/ssh.sh"
source "$KNOT_ROOT/core/modules/firewall.sh"
source "$KNOT_ROOT/core/modules/sudo.sh"
source "$KNOT_ROOT/core/modules/guard.sh"
source "$KNOT_ROOT/core/modules/mdns.sh"
source "$KNOT_ROOT/core/modules/deskflow.sh"
source "$KNOT_ROOT/core/modules/autounlock.sh"
source "$KNOT_ROOT/core/modules/autologin.sh"
source "$KNOT_ROOT/core/modules/kdeconnect.sh"
source "$KNOT_ROOT/core/modules/doctor.sh"
source "$KNOT_ROOT/core/modules/antigravity.sh"
source "$KNOT_ROOT/core/modules/auth.sh"
source "$KNOT_ROOT/core/modules/hub.sh"
source "$KNOT_ROOT/core/modules/memory.sh"
source "$KNOT_ROOT/core/modules/shutdown.sh"
source "$KNOT_ROOT/core/modules/topology.sh"
source "$KNOT_ROOT/core/modules/swarm_sync.sh"
source "$KNOT_ROOT/core/modules/council.sh"

cmd_onboard() {
  local node_id="${1:-}"
  if [ -z "$node_id" ]; then
    local default_host
    default_host="$(knot_detect_hostname)"
    node_id="$default_host"
  fi

  knot_log_info "Onboarding node '$node_id' into Knot mesh..."

  ssh_ensure_local_key
  firewall_configure
  sudo_configure
  ssh_harden_server
  guard_configure
  mdns_configure
  autologin_ensure_dm
  antigravity_onboard

  local user
  user="$(knot_detect_user)"
  local host
  host="$(knot_detect_hostname)"
  local home
  home="$(knot_detect_user_home)"
  local pubkey
  pubkey="$(cat "$home/.ssh/id_ed25519.pub" | tr -d '\n')"
  local subnet
  subnet="$(knot_detect_subnet)"
  local gw_mac
  local ssh_port
  ssh_port="$(knot_detect_sshd_port)"
  local ip_hint=""
  local ip_out
  if ip_out="$(ip -4 -o addr show)"; then
    ip_hint="$(echo "$ip_out" | grep -v ' 127\.' | grep -v 'docker' | grep -v 'virbr' | grep -v 'waydroid' | awk '{print $4}' | cut -d/ -f1 | head -n1)"
  fi

  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local nodes_dir=""
  if ! nodes_dir="$(knot_get_nodes_dir)"; then
    local home
    home="$(knot_detect_user_home)"
    nodes_dir="$home/.config/knot/swarms/${active_swarm:-home}/nodes"
  fi
  mkdir -p "$nodes_dir"
  local manifest="$nodes_dir/${node_id}.json"

  local iface_json=""
  local first=1
  while IFS='|' read -r iface type mac ip; do
    [ -n "$iface" ] || continue
    if [ $first -eq 0 ]; then iface_json+=", "; fi
    iface_json+="\"$iface\": {\"type\": \"$type\", \"mac\": \"$mac\", \"ip\": \"$ip\"}"
    first=0
  done < <(knot_detect_network_interfaces)

  cat << JSON_EOF > "$manifest"
{
  "id": "$node_id",
  "hostname": "$host",
  "user": "$user",
  "port": $ssh_port,
  "mdns": "${host}.local",
  "ip_hint": "$ip_hint",
  "subnet": "$subnet",
  "gateway_mac": "$gw_mac",
  "interfaces": { $iface_json },
  "pubkey": "$pubkey"
}
JSON_EOF

  knot_log_ok "Node manifest registered at $manifest"

  cmd_sync

  # Deploy and enable Tier 1 D2D KDE Connect reconciler timer
  local user_unit_dir="${HOME}/.config/systemd/user"
  mkdir -p "$user_unit_dir"
  if [ -f "$KNOT_ROOT/systemd/knot-kdeconnect-reconcile.service" ]; then
    ln -sf "$KNOT_ROOT/systemd/knot-kdeconnect-reconcile.service" "$user_unit_dir/knot-kdeconnect-reconcile.service"
  fi
  if [ -f "$KNOT_ROOT/systemd/knot-kdeconnect-reconcile.timer" ]; then
    ln -sf "$KNOT_ROOT/systemd/knot-kdeconnect-reconcile.timer" "$user_unit_dir/knot-kdeconnect-reconcile.timer"
    if command -v systemctl >/dev/null; then
      local r_out=""
      if ! r_out="$(systemctl --user daemon-reload 2>&1)"; then
        knot_log_warn "Notice: systemctl daemon-reload returned: $r_out"
      fi
      local t_out=""
      if ! t_out="$(systemctl --user enable --now knot-kdeconnect-reconcile.timer 2>&1)"; then
        knot_log_warn "Notice: Could not enable knot-kdeconnect-reconcile.timer: $t_out"
      fi
    fi
  fi

  # Turnkey initial KDE Connect mesh reconciliation with non-blocking fallback
  knot_log_info "Initiating turnkey KDE Connect mesh reconciliation..."
  local rec_out="" rec_rc=0
  if rec_out="$(kdeconnect_reconcile 2>&1)"; then
    knot_log_ok "KDE Connect mesh paired and active."
  else
    rec_rc=$?
    knot_log_info "Notice: Initial KDE Connect pairing returned ($rec_rc). Background D2D timer will finalize reconciliation."
  fi

  knot_log_ok "Node '$node_id' successfully onboarded into Knot!"
}

cmd_sync() {
  local target=""
  local dev_mode=0
  local force_prod=0
  local force_dev=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo -e "${C_BOLD}knot sync - Mesh Configuration & Topology Synchronizer${C_RESET}"
        echo "Usage:"
        echo "  knot sync [options]                 Synchronize local node configuration & topology"
        echo "  knot sync --all [options]           Anchor mode: Synchronize configurations across all active Strands"
        echo "  knot sync <node_id> [options]       Synchronize configuration to a specific Strand"
        echo ""
        echo "Options:"
        echo "  --dev          Development mode: auto-heal symlinks, global hooks, Antigravity settings & drift"
        echo "  --force-prod   Bypass development lockout to run production sync on a dev node"
        echo "  --force-dev    Bypass production lockout to run dev sync on a prod node"
        echo "  -h, --help     Show this help message"
        return 0
        ;;
      --dev)
        dev_mode=1
        shift
        ;;
      --force-prod)
        force_prod=1
        shift
        ;;
      --force-dev)
        force_dev=1
        shift
        ;;
      --all)
        target="--all"
        shift
        ;;
      local)
        target="local"
        shift
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  # Safety Lockouts
  if [ $dev_mode -eq 1 ]; then
    knot_enforce_lockout "dev" "knot sync" $force_dev || return 1
    swarm_sync_dev "$target"
    return $?
  else
    knot_enforce_lockout "prod" "knot sync" $force_prod || return 1
  fi

  local my_host my_node_id
  my_host="$(knot_detect_hostname)"
  my_node_id="$(knot_detect_node_id)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_id="desktop"
  local anchor_host="desktop"

  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if knot_is_anchor || [ "$my_node_id" = "$anchor_id" ] || [ "$my_host" = "$anchor_host" ] || [ "$my_host" = "$anchor_id" ]; then
    is_anchor=1
  fi

  if [ "$is_anchor" -eq 1 ]; then
    # Running on Anchor Workstation
    if [ "$target" = "--all" ]; then
      knot_log_info "Synchronizing Knot mesh across local system ($my_host)..."
      ssh_sync_authorized_keys
      ssh_sync_client_config
      deskflow_configure
      kdeconnect_sync_mesh
      knot_log_ok "Local Anchor configuration synchronized."

      local nodes_dir=""
      if ! nodes_dir="$(knot_get_nodes_dir)"; then
        knot_log_err "No nodes directory found for active swarm '$active_swarm'"
        return 1
      fi

      local topo_file=""
      local user_home
      user_home="$(knot_detect_user_home)"
      if [ -r "$user_home/.config/knot/swarms/${active_swarm}/topology.json" ]; then
        topo_file="$user_home/.config/knot/swarms/${active_swarm}/topology.json"
      elif [ -r "/etc/knot/swarms.d/${active_swarm}/topology.json" ]; then
        topo_file="/etc/knot/swarms.d/${active_swarm}/topology.json"
      fi

      local swarm_conf=""
      if [ -r "/etc/knot/swarms.d/${active_swarm}.conf" ]; then
        swarm_conf="/etc/knot/swarms.d/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}/swarm.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}/swarm.conf"
      fi

      local sync_count=0
      for manifest in "$nodes_dir/"*.json; do
        [ -e "$manifest" ] || continue
        local id host role
        id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        role="$(awk -F'"' '/"role":/ {print $4}' "$manifest")"

        if [ "$id" = "$anchor_id" ] || [ "$host" = "$anchor_host" ] || [ "$id" = "$my_host" ] || [ "$host" = "$my_host" ] || [ "$role" = "anchor" ]; then
          continue
        fi

        swarm_sync_anchor_push "$id" "$active_swarm" "$nodes_dir" "$topo_file" "$swarm_conf" 0 "$force_prod"
        sync_count=$((sync_count + 1))
      done
      knot_log_ok "Mesh-wide swarm synchronization complete ($sync_count Strands updated)."
    elif [ -n "$target" ] && [ "$target" != "$my_node_id" ] && [ "$target" != "$my_host" ] && [ "$target" != "$anchor_id" ] && [ "$target" != "local" ] && [ "$target" != "localhost" ]; then
      # Targeted Strand sync from Anchor
      local nodes_dir=""
      if ! nodes_dir="$(knot_get_nodes_dir)"; then
        knot_log_err "No nodes directory found for active swarm '$active_swarm'"
        return 1
      fi

      local topo_file=""
      local user_home
      user_home="$(knot_detect_user_home)"
      if [ -r "$user_home/.config/knot/swarms/${active_swarm}/topology.json" ]; then
        topo_file="$user_home/.config/knot/swarms/${active_swarm}/topology.json"
      elif [ -r "/etc/knot/swarms.d/${active_swarm}/topology.json" ]; then
        topo_file="/etc/knot/swarms.d/${active_swarm}/topology.json"
      fi

      local swarm_conf=""
      if [ -r "/etc/knot/swarms.d/${active_swarm}.conf" ]; then
        swarm_conf="/etc/knot/swarms.d/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${active_swarm}/swarm.conf" ]; then
        swarm_conf="$user_home/.config/knot/swarms/${active_swarm}/swarm.conf"
      fi

      swarm_sync_anchor_push "$target" "$active_swarm" "$nodes_dir" "$topo_file" "$swarm_conf" 0 "$force_prod"
      knot_log_ok "Swarm synchronization to Strand '$target' complete."
    else
      # Local sync only on Anchor
      knot_log_info "Synchronizing Knot mesh across local system ($my_host)..."
      ssh_sync_authorized_keys
      ssh_sync_client_config
      deskflow_configure
      kdeconnect_sync_mesh
      knot_log_ok "Knot mesh synchronization complete."
    fi
  else
    # Running locally on Strand
    if [ -n "$target" ] && [ "$target" != "--all" ] && [ "$target" != "$my_host" ] && [ "$target" != "local" ] && [ "$target" != "localhost" ]; then
      knot_log_warn "Notice: Device '$my_host' is a Strand. Multi-node distribution is orchestrated by the Anchor ($anchor_host)."
    fi
    swarm_sync_strand_pull
  fi
}

cmd_resolve() {
  exec "$KNOT_ROOT/core/resolver.sh" "$@"
}

cmd_status() {
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  echo -e "${C_BOLD}--- Knot Mesh Status (${active_swarm:-standalone}) ---${C_RESET}"
  printf "%-12s %-10s %-6s %-16s %-8s %-8s %-20s\n" "NODE" "USER" "PORT" "LAST IP" "MESH" "PING" "KVM STATUS"
  printf "%-12s %-10s %-6s %-16s %-8s %-8s %-20s\n" "----" "----" "----" "-------" "----" "----" "----------"

  local nodes_dir=""
  if ! nodes_dir="$(knot_get_nodes_dir)"; then
    nodes_dir=""
  fi

  local my_host my_node_id
  my_host="$(knot_detect_hostname)"
  my_node_id="$(knot_detect_node_id)"
  local anchor_id="desktop"
  local anchor_host="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  elif [ -n "$nodes_dir" ] && [ -d "$nodes_dir" ]; then
    for manifest in "$nodes_dir/"*.json; do
      [ -e "$manifest" ] || continue
      if grep -q '"role":[[:space:]]*"anchor"' "$manifest"; then
        anchor_id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        anchor_host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        break
      fi
    done
  fi

  local established_kvm_ips=""
  if knot_is_anchor || [ "$my_node_id" = "$anchor_id" ] || [ "$my_host" = "$anchor_host" ] || [ "$my_host" = "$anchor_id" ]; then
    local ss_out=""
    if ss_out="$(ss -H -tn state established sport = :24800 2>&1)"; then
      established_kvm_ips="$(echo "$ss_out" | awk '{print $4}' | cut -d: -f1)"
    fi
  else
    local ssh_ss_out=""
    if ssh_ss_out="$(ssh -o BatchMode=yes -o ConnectTimeout=2 "$anchor_id" "ss -H -tn state established sport = :24800" 2>&1)"; then
      established_kvm_ips="$(echo "$ssh_ss_out" | awk '{print $4}' | cut -d: -f1)"
    fi
  fi

  if [ -n "$nodes_dir" ] && [ -d "$nodes_dir" ]; then
    for manifest in "$nodes_dir/"*.json; do
      [ -e "$manifest" ] || continue
      local id user ip_hint port host
      id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
      user="$(awk -F'"' '/"user":/ {print $4}' "$manifest")"
      host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
      ip_hint="$(awk -F'"' '/"ip_hint":/ {print $4}' "$manifest")"
      port="$(awk -F: '/"port":/ {gsub(/[^0-9]/, "", $2); print $2}' "$manifest")"
      if [ -z "$port" ]; then port="22"; fi

      local resolved_ip=""
      if ! resolved_ip="$("$KNOT_ROOT/core/resolver.sh" "$id" "$port")"; then
        resolved_ip=""
      fi

      if [ -n "$resolved_ip" ]; then
        local ping_time="ok"
        local ping_out=""
        if ping_out="$(ping -c 1 -W 1 "$resolved_ip" 2>&1)"; then
          local rtt
          rtt="$(echo "$ping_out" | awk -F'/' '/rtt/ {print $5}')"
          if [ -n "$rtt" ]; then
            ping_time="${rtt%.*}ms"
          fi
        fi

        local kvm_status="${C_YELLOW}DISCONNECTED${C_RESET}"
        if [ "$id" = "$anchor_id" ] || [ "$host" = "$anchor_host" ]; then
          local count=0
          if [ -n "$established_kvm_ips" ]; then
            count="$(echo "$established_kvm_ips" | grep -v '^$' | wc -l)"
          fi
          kvm_status="${C_GREEN}SERVER ($count connected)${C_RESET}"
        else
          if [ -n "$established_kvm_ips" ] && echo "$established_kvm_ips" | grep -q "$resolved_ip"; then
            kvm_status="${C_GREEN}CONNECTED${C_RESET}"
          else
            kvm_status="${C_YELLOW}DISCONNECTED${C_RESET}"
          fi
        fi

        printf "%-12s %-10s %-6s %-16s ${C_GREEN}%-8s${C_RESET} %-8s %-20b\n" "$id" "$user" "$port" "$resolved_ip" "ONLINE" "$ping_time" "$kvm_status"
      else
        printf "%-12s %-10s %-6s %-16s ${C_RED}%-8s${C_RESET} %-8s %-20b\n" "$id" "$user" "$port" "${ip_hint:-(unknown)}" "OFFLINE" "-" "${C_RED}OFFLINE${C_RESET}"
      fi
    done
  fi
}


cmd_exec() {
  local tty_opts=()
  if [ "${1:-}" = "-t" ] || [ "${1:-}" = "-tt" ]; then
    tty_opts=("$1")
    shift
  fi
  local target="${1:-}"
  [ $# -gt 0 ] && shift
  local cmd="$*"

  if [ -z "$target" ] || [ -z "$cmd" ]; then
    knot_log_err "Usage: knot exec [-t] <node_id|--all> <command>"
    exit 1
  fi

  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_host="desktop.local"
  local hub_port=4242
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_host="${ANCHOR_HOST:-desktop.local}"
    hub_port="${HUB_PORT:-4242}"
  fi

  local my_node_id my_host
  my_node_id="$(knot_detect_node_id)"
  my_host="$(knot_detect_hostname)"

  local anchor_env="export KNOT_MESH_ANCHOR=\"desktop\";"
  local council_env=""
  if [ -n "${KNOT_COUNCIL_RUN_ID:-}" ]; then
    council_env="export KNOT_RUN_ID=\"$KNOT_COUNCIL_RUN_ID\"; export KNOT_COUNCIL_RUN_ID=\"$KNOT_COUNCIL_RUN_ID\";"
  fi

  if [ "$target" = "--all" ]; then
    local nodes_dir=""
    if ! nodes_dir="$(knot_get_nodes_dir 2>&1)"; then
      knot_log_warn "No active swarm nodes directory found."
      return 1
    fi
    for manifest in "$nodes_dir/"*.json; do
      [ -e "$manifest" ] || continue
      local id host
      id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
      host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
      echo -e "\n${C_CYAN}=== [$id] ===${C_RESET}"

      local target_hub_url
      if [ "$id" = "$my_node_id" ] || [ "$host" = "$my_host" ]; then
        target_hub_url="${KNOT_HUB_URL:-$(hub_resolve_url || echo "https://127.0.0.1:${hub_port}")}"
      else
        target_hub_url="${KNOT_HUB_URL:-https://${anchor_host}:${hub_port}}"
      fi
      local remote_cmd="export TERM=\"\${TERM:-xterm-256color}\"; export PATH=\"\$HOME/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:\$PATH\"; export KNOT_NODE_ID=\"$id\"; export KNOT_HUB_URL=\"$target_hub_url\"; $anchor_env $council_env $cmd"

      local e_out=""
      if [ "$id" = "$my_node_id" ] || [ "$host" = "$my_host" ]; then
        if e_out="$(bash -c "$remote_cmd" 2>&1)"; then
          echo "$e_out"
        else
          knot_log_warn "Notice: Command failed locally on $id: $e_out"
        fi
      elif e_out="$(ssh -o BatchMode=yes -o ConnectTimeout=3 "$id" "$remote_cmd" 2>&1)"; then
        echo "$e_out"
      else
        knot_log_warn "Notice: Command failed on $id: $e_out"
      fi
    done
  else
    local nodes_dir=""
    if ! nodes_dir="$(knot_get_nodes_dir 2>&1)"; then
      nodes_dir=""
    fi
    local target_nid="$target"
    local is_local=0
    if [ "$target" = "$my_node_id" ] || [ "$target" = "$my_host" ] || [ "$target" = "local" ] || [ "$target" = "localhost" ] || [ "$target" = "127.0.0.1" ]; then
      is_local=1
      target_nid="$my_node_id"
    elif [ -n "$nodes_dir" ] && [ -d "$nodes_dir" ]; then
      for mf in "$nodes_dir/"*.json; do
        [ -e "$mf" ] || continue
        local mid mhost
        mid="$(awk -F'"' '/"id":/ {print $4}' "$mf")"
        mhost="$(awk -F'"' '/"hostname":/ {print $4}' "$mf")"
        if [ "$target" = "$mid" ] || [ "$target" = "$mhost" ]; then
          target_nid="$mid"
          if [ "$mid" = "$my_node_id" ] || [ "$mhost" = "$my_host" ]; then
            is_local=1
          fi
          break
        fi
      done
    fi

    local target_hub_url
    if [ "$is_local" -eq 1 ]; then
      target_hub_url="${KNOT_HUB_URL:-$(hub_resolve_url || echo "https://127.0.0.1:${hub_port}")}"
    else
      target_hub_url="${KNOT_HUB_URL:-https://${anchor_host}:${hub_port}}"
    fi
    local remote_cmd="export TERM=\"\${TERM:-xterm-256color}\"; export PATH=\"\$HOME/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:\$PATH\"; export KNOT_NODE_ID=\"$target_nid\"; export KNOT_HUB_URL=\"$target_hub_url\"; $anchor_env $council_env $cmd"

    if [ "$is_local" -eq 1 ]; then
      bash -c "$remote_cmd"
    else
      if [ ${#tty_opts[@]} -gt 0 ]; then
        ssh "${tty_opts[@]}" -o ConnectTimeout=5 "$target_nid" "$remote_cmd"
      else
        ssh -o BatchMode=yes -o ConnectTimeout=5 "$target_nid" "$remote_cmd"
      fi
    fi
  fi
}

cmd_kvm() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  local my_host
  my_host="$(knot_detect_hostname)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_host="desktop"
  local anchor_id="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if knot_is_anchor; then
    is_anchor=1
  fi

  case "$action" in
    restart)
      knot_log_info "Restarting Deskflow KVM across the Knot mesh..."

      if [ "$is_anchor" -eq 1 ]; then
        knot_log_info "Restarting KVM Server locally on Anchor ($anchor_host)..."
        systemctl --user restart knot-deskflow
        sleep 1.5

        local nodes_dir=""
        if ! nodes_dir="$(knot_get_nodes_dir)"; then
          local home
          home="$(knot_detect_user_home)"
          if [ -d "$home/.config/knot/swarms/${active_swarm}/nodes" ]; then
            nodes_dir="$home/.config/knot/swarms/${active_swarm}/nodes"
          fi
        fi

        if [ -n "$nodes_dir" ]; then
          for manifest in "$nodes_dir/"*.json; do
            [ -e "$manifest" ] || continue
            local id host
            id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
            host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
            if [ -n "$id" ] && [ "$id" != "$anchor_id" ] && [ "$host" != "$anchor_host" ]; then
              knot_log_info "Restarting KVM Client remotely on $id ($host)..."
              local r_out
              if r_out="$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$id" "systemctl --user restart knot-deskflow" 2>&1)"; then
                :
              else
                knot_log_warn "Notice: Could not restart KVM remotely on $id: $r_out"
              fi
            fi
          done
        fi
      else
        knot_log_info "Restarting KVM Client locally on Strand ($my_host)..."
        systemctl --user restart knot-deskflow
      fi

      sleep 1
      knot_log_ok "Deskflow KVM restarted."
      ;;
    lock)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      deskflow_set_lock "locked"
      ;;
    unlock)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      deskflow_set_lock "unlocked"
      ;;
    lock-toggle|toggle-lock)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      deskflow_set_lock "toggle"
      ;;
    status)
      source "$KNOT_ROOT/core/modules/deskflow.sh"
      local lock_status
      lock_status="$(deskflow_get_lock)"
      if [ "$lock_status" = "locked" ]; then
        knot_log_warn "KVM Cursor Lock: LOCKED (host confined to desktop)"
      else
        knot_log_ok "KVM Cursor Lock: UNLOCKED (multi-screen crossover active)"
      fi

      local my_host
      my_host="$(knot_detect_hostname)"
      local established=""
      if [ "$my_host" = "$anchor_host" ]; then
        local ss_out
        if ss_out="$(ss -H -tn state established sport = :24800)"; then
          established="$(echo "$ss_out" | awk '{print $4}' | cut -d: -f1)"
        fi
      else
        local ssh_ss_out
        if ssh_ss_out="$(ssh -o BatchMode=yes -o ConnectTimeout=2 desktop "ss -H -tn state established sport = :24800")"; then
          established="$(echo "$ssh_ss_out" | awk '{print $4}' | cut -d: -f1)"
        fi
      fi
      local count=0
      if [ -n "$established" ]; then
        count="$(echo "$established" | grep -v '^$' | wc -l)"
      fi
      knot_log_info "Established KVM Sockets on Anchor: $count client(s) connected"
      for ip in $established; do
        echo -e "  -> $ip connected"
      done

      knot_log_info "Deskflow KVM service status across the mesh:"
      cmd_exec --all "systemctl --user show knot-deskflow -p ActiveState,SubState --value | tr '\n' ' '; echo"
      knot_log_info "KVM Auto-Unlock daemon status across the mesh:"
      cmd_exec --all "systemctl --user show knot-autounlock -p ActiveState,SubState --value | tr '\n' ' '; echo"
      ;;
    *)
      echo "Usage: knot kvm <restart|status|lock|unlock|lock-toggle>"
      ;;
  esac
}

cmd_doctor() {
  local is_repair=0
  local repair_args=()
  for arg in "$@"; do
    if [ "$arg" = "--repair" ]; then
      is_repair=1
    else
      repair_args+=("$arg")
    fi
  done
  if [ $is_repair -eq 1 ]; then
    doctor_repair "${repair_args[@]:-}"
  else
    doctor_diagnose "$@"
  fi
}

cmd_repair() {
  doctor_repair "$@"
}

cmd_council() {
  local action="${1:-start}"
  if [ $# -gt 0 ]; then shift; fi

  case "$action" in
    start) council_start "$@" ;;
    resume) council_resume "$@" ;;
    status) council_status "$@" ;;
    reply) council_reply "$@" ;;
    list) council_list "$@" ;;
    attach) council_attach "$@" ;;
    reconcile) council_reconcile "$@" ;;
    copy) council_copy "$@" ;;
    clean) council_clean "$@" ;;
    kill) council_kill "$@" ;;
    steer) council_steer "$@" ;;
    challenge) council_challenge "$@" ;;
    db) council_db "$@" ;;
    board|live|viewer) council_board "$@" ;;
    heal) council_heal "$@" ;;
    audit) bash "$KNOT_ROOT/runtime/skills/swarm-council/scripts/audit_tools.sh" "$@" ;;
    sync) bash "$KNOT_ROOT/runtime/skills/swarm-council/scripts/project_sync.sh" "$@" ;;
    *)
      echo "Usage: knot council <start|resume|status|reply|list|attach|reconcile|steer|challenge|db|board|heal|copy|clean|kill|audit|sync> [options]"
      ;;
  esac
}

cmd_color() {
  python3 "$KNOT_ROOT/core/palette.py" "$@"
}

cmd_swarm() {
  local action="${1:-status}"
  if [ $# -gt 0 ]; then shift; fi

  case "$action" in
    switch|use)
      local target_swarm="${1:-}"
      if [ -z "$target_swarm" ]; then
        knot_log_err "Usage: knot swarm switch <swarm_id>"
        exit 1
      fi

      local user_home
      user_home="$(knot_detect_user_home)"
      local profile_found=0
      local profile_path=""

      if [ -r "/etc/knot/swarms.d/${target_swarm}.conf" ]; then
        profile_found=1
        profile_path="/etc/knot/swarms.d/${target_swarm}.conf"
      elif [ -r "$user_home/.config/knot/swarms/${target_swarm}/swarm.conf" ]; then
        profile_found=1
        profile_path="$user_home/.config/knot/swarms/${target_swarm}/swarm.conf"
      elif [ -r "$user_home/.config/knot/swarms/${target_swarm}.conf" ]; then
        profile_found=1
        profile_path="$user_home/.config/knot/swarms/${target_swarm}.conf"
      fi

      if [ "$profile_found" -eq 0 ]; then
        knot_log_err "Swarm profile for '$target_swarm' not found in /etc/knot/swarms.d/${target_swarm}.conf or ~/.config/knot/swarms/${target_swarm}/swarm.conf"
        exit 1
      fi

      knot_set_active_swarm "$target_swarm"
      knot_log_ok "Switched active swarm to '$target_swarm'."

      local my_host
      my_host="$(knot_detect_hostname)"
      local anchor_id="desktop"
      local anchor_host="desktop.local"

      if [ -n "$profile_path" ]; then
        local a_id a_host
        a_id="$(awk -F= '/^ANCHOR_ID=/ {print $2}' "$profile_path" | tr -d '"'\'' ')"
        a_host="$(awk -F= '/^ANCHOR_HOST=/ {print $2}' "$profile_path" | tr -d '"'\'' ')"
        [ -n "$a_id" ] && anchor_id="$a_id"
        [ -n "$a_host" ] && anchor_host="$a_host"
      fi

      local is_anchor=0
      if [ "$my_host" = "$anchor_host" ] || [ "$my_host" = "$anchor_id" ]; then
        is_anchor=1
      else
        local nodes_dir=""
        if [ -d "$user_home/.config/knot/swarms/${target_swarm}/nodes" ]; then
          nodes_dir="$user_home/.config/knot/swarms/${target_swarm}/nodes"
        elif [ -d "/etc/knot/swarms.d/${target_swarm}/nodes" ]; then
          nodes_dir="/etc/knot/swarms.d/${target_swarm}/nodes"
        fi
        if [ -n "$nodes_dir" ] && [ -r "$nodes_dir/${anchor_id}.json" ]; then
          local m_host
          m_host="$(awk -F'"' '/"hostname":/ {print $4}' "$nodes_dir/${anchor_id}.json")"
          if [ "$m_host" = "$my_host" ] || grep -q "\"$my_host\"" "$nodes_dir/${anchor_id}.json"; then
            is_anchor=1
          fi
        fi
      fi

      if [ "$is_anchor" -eq 1 ]; then
        knot_log_info "Node '$my_host' is ANCHOR in swarm '$target_swarm'. Recompiling Deskflow server configuration..."
        deskflow_write_server_conf
      else
        knot_log_info "Node '$my_host' is STRAND in swarm '$target_swarm'. Recompiling Deskflow client configuration..."
        deskflow_write_client_conf
      fi

      if command -v systemctl >/dev/null; then
        local d_out="" s_out=""
        if d_out="$(systemctl --user restart knot-deskflow.service 2>&1)"; then
          knot_log_ok "Restarted knot-deskflow service."
        else
          knot_log_warn "Notice: knot-deskflow restart: $d_out"
        fi

        if s_out="$(systemctl --user restart knot-stripd.service 2>&1)"; then
          knot_log_ok "Restarted knot-stripd service."
        else
          knot_log_warn "Notice: knot-stripd restart: $s_out"
        fi
      fi
      ;;
    status)
      antigravity_swarm_status
      ;;
    quota)
      antigravity_swarm_quota "$@"
      ;;
    test)
      antigravity_swarm_test "$@"
      ;;
    exec)
      if [ $# -lt 2 ]; then
        knot_log_err "Usage: knot swarm exec <node> \"<prompt>\" [extra_flags]"
        exit 1
      fi
      local target="$1"
      local prompt="$2"
      shift 2
      antigravity_exec_node "$target" "$prompt" "$@"
      ;;
    auth)
      antigravity_swarm_auth "$@"
      ;;
    color|colors|palette)
      cmd_color "$@"
      ;;
    *)
      echo "Usage: knot swarm <status|quota [node|--all]|auth [node|--gui]|color [node]|test [node|--all]|exec <node> \"<prompt>\">"
      exit 1
      ;;
  esac
}


cmd_kdeconnect() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  case "$action" in
    sync)
      if [ "${1:-}" = "--all" ]; then
        knot_log_info "Synchronizing KDE Connect & enforcing clipboard sharing across the entire mesh..."
        cmd_exec --all "knot kdeconnect sync"
      else
        kdeconnect_sync_mesh
      fi
      ;;
    status)
      if [ "${1:-}" = "--all" ]; then
        knot_log_info "KDE Connect status across the mesh:"
        cmd_exec --all "knot kdeconnect status"
      else
        kdeconnect_status
      fi
      ;;
    pair)
      kdeconnect_pair "$@"
      ;;
    prune-stale)
      kdeconnect_prune_stale "$@"
      ;;
    share)
      kdeconnect_share "$@"
      ;;
    sync-clipboard)
      kdeconnect_sync_clipboard "$@"
      ;;
    test-clipboard)
      kdeconnect_test_clipboard "$@"
      ;;
    reconcile)
      kdeconnect_reconcile "$@"
      ;;
    get-clipboard)
      kdeconnect_get_clipboard "$@"
      ;;
    set-clipboard)
      kdeconnect_set_clipboard "$@"
      ;;
    vmon|virtual-monitor)
      local vmon_action="${1:-status}"
      [ $# -gt 0 ] && shift
      case "$vmon_action" in
        status)
          kdeconnect_vmon_status "$@"
          ;;
        start)
          kdeconnect_vmon_start "$@"
          ;;
        stop)
          kdeconnect_vmon_stop "$@"
          ;;
        *)
          echo "Usage: knot kdeconnect vmon <status [<node>]|start <node>|stop [<node>]>"
          exit 1
          ;;
      esac
      ;;
    *)
      echo "Usage: knot kdeconnect <status [--all]|sync [--all]|pair [<node_id>|--all]|reconcile|vmon <status|start|stop>|share --target <node> [<payload>]|sync-clipboard [--all|<node>]|test-clipboard [--all|<node>]|prune-stale>"
      ;;
  esac
}

