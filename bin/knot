cmd_shutdown() {
  local target="local"
  local action="poweroff"
  local delay="now"
  local wall_msg="Graceful shutdown scheduled via Knot Swarm"
  local force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo -e "${C_BOLD}knot shutdown - Graceful Swarm-wide Shutdown & Reboot${C_RESET}"
        echo "Usage:"
        echo "  knot shutdown [target] [options]"
        echo ""
        echo "Targets:"
        echo "  local, desktop, laptop, steamdeck, or --all (default: local)"
        echo ""
        echo "Options:"
        echo "  -d, --delay <time>   Delay before shutdown (e.g. '5m', '10', '60s', 'now'; default: now)"
        echo "  -r, --reboot         Reboot instead of power off"
        echo "  -c, --cancel         Cancel scheduled shutdown on target(s)"
        echo "  -s, --show, status   Show scheduled shutdown status"
        echo "  -m, --msg <text>     Custom wall message broadcast to users"
        echo "  -f, --force, -y      Skip interactive confirmation prompt"
        echo ""
        echo "Examples:"
        echo "  knot shutdown laptop --delay 5m    Schedule laptop shutdown in 5 minutes"
        echo "  knot shutdown --all --reboot       Reboot all mesh nodes gracefully"
        echo "  knot shutdown --all --cancel       Cancel scheduled shutdowns across swarm"
        echo "  knot shutdown --all status         Inspect pending shutdowns across swarm"
        return 0
        ;;
      -r|--reboot)
        action="reboot"
        shift
        ;;
      -c|--cancel)
        action="cancel"
        shift
        ;;
      -s|--show|status)
        action="show"
        shift
        ;;
      -d|--delay)
        delay="$2"
        shift 2
        ;;
      -m|--msg)
        wall_msg="$2"
        shift 2
        ;;
      --action)
        action="$2"
        shift 2
        ;;
      -f|--force|-y|--yes)
        force=1
        shift
        ;;
      --all)
        target="--all"
        shift
        ;;
      local|desktop|laptop|steamdeck)
        target="$1"
        shift
        ;;
      *)
        if [[ "$1" =~ ^- ]]; then
          knot_log_err "Unknown shutdown option: $1"
          return 1
        else
          target="$1"
          shift
        fi
        ;;
    esac
  done

  # If action is poweroff or reboot, and not forced, ask confirmation
  if [ "$action" != "cancel" ] && [ "$action" != "show" ] && [ $force -eq 0 ]; then
    echo -e "${C_YELLOW}${C_BOLD}[!] CONFIRMATION REQUIRED:${C_RESET}"
    echo -e "    Action: ${C_RED}${action^^}${C_RESET}"
    echo -e "    Target: ${C_BOLD}${target}${C_RESET}"
    echo -e "    Delay:  ${C_BOLD}${delay}${C_RESET}"
    read -r -p "    Are you sure you want to proceed? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
      knot_log_info "Operation cancelled by user."
      return 0
    fi
  fi

  if [ "$target" = "--all" ]; then
    shutdown_exec_all "$action" "$delay" "$wall_msg"
  elif [ "$target" = "local" ]; then
    shutdown_exec_local "$action" "$delay" "$wall_msg"
  else
    shutdown_exec_remote "$target" "$action" "$delay" "$wall_msg"
  fi
}

cmd_mcp() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift

  case "$action" in
    sync)
      local target="${1:-local}"
      if [ "$target" = "--all" ] || [ "$target" = "all" ]; then
        knot_log_info "Synchronizing Knot MCP suite across all mesh nodes..."
        python3 "$KNOT_ROOT/core/mcp/sync.py"
        local nodes_dir=""
        if nodes_dir="$(knot_get_nodes_dir)"; then
          for manifest in "$nodes_dir/"*.json; do
            [ -e "$manifest" ] || continue
            local id host
            id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
            host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
            local my_node_id my_host
            my_node_id="$(knot_detect_node_id)"
            my_host="$(knot_detect_hostname)"
            if [ "$id" != "$my_node_id" ] && [ "$host" != "$my_host" ]; then
              knot_log_info "Synchronizing MCP on remote node: $id ($host)..."
              knot exec "$id" "python3 $KNOT_ROOT/core/mcp/sync.py" || knot_log_warn "Failed to sync MCP on $id"
            fi
          done
        fi
        knot_log_ok "Mesh-wide MCP synchronization complete."
      elif [ "$target" = "local" ] || [ "$target" = "$my_node_id" ] || [ "$target" = "$my_host" ]; then
        python3 "$KNOT_ROOT/core/mcp/sync.py"
      else
        knot_log_info "Synchronizing MCP on $target..."
        knot exec "$target" "python3 $KNOT_ROOT/core/mcp/sync.py"
      fi
      ;;
    test)
      python3 "$KNOT_ROOT/core/mcp/gateway.py" --test
      ;;
    list|status)
      echo -e "${C_BOLD}--- Knot MCP Gateway Tools ---${C_RESET}"
      python3 -c "
import sys; sys.path.insert(0, '$KNOT_ROOT')
from core.mcp.gateway import KnotMCPGateway, KnotHubClient
gw = KnotMCPGateway(KnotHubClient())
tools = gw._handle_tools_list({})['tools']
for i, t in enumerate(tools, 1):
    print(f'  {i:2d}. {t[\"name\"]:24s} - {t[\"description\"]}')
"
      ;;
    *)
      knot_log_err "Usage: knot mcp [sync [--all]|test|list]"
      exit 1
      ;;
  esac
}

cmd_update_dev() {
  local target="${1:-local}"
  local force_dev="${2:-0}"

  local my_host my_node_id
  my_host="$(knot_detect_hostname)"
  my_node_id="$(knot_detect_node_id)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_id="desktop"
  local anchor_host="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if knot_is_anchor || [ "$anchor_id" = "$my_node_id" ] || [ "$anchor_id" = "$my_host" ] || [ "$anchor_host" = "$my_host" ]; then
    is_anchor=1
  fi

  # If run on a Strand and targeting remote or fleet, delegate to Anchor
  if [ $is_anchor -eq 0 ] && [ "$target" != "local" ] && [ "$target" != "$my_node_id" ] && [ "$target" != "$my_host" ]; then
    knot_log_info "Node '$my_node_id' is a Strand. Delegating dev update to Anchor ($anchor_id)..."
    local remote_cmd="export PATH=\"\$HOME/.local/bin:\$PATH\"; export KNOT_NODE_ID=\"$anchor_id\"; knot update --dev $target"
    if [ "$force_dev" -eq 1 ]; then
      remote_cmd="$remote_cmd --force-dev"
    fi
    if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$anchor_id" "$remote_cmd"; then
      knot_log_err "Failed to execute dev update on Anchor ($anchor_id)"
      return 1
    fi
    return 0
  fi

  # 1. Update local node if target is local, --all, or self
  if [ "$target" = "local" ] || [ "$target" = "$my_node_id" ] || [ "$target" = "$my_host" ] || [ "$target" = "--all" ]; then
    knot_log_info "Updating local development repository ($KNOT_ROOT)..."
    if [ -d "$KNOT_ROOT/.git" ]; then
      local pull_out=""
      if pull_out="$(git -C "$KNOT_ROOT" pull --ff-only 2>&1)"; then
        knot_log_ok "Local git pull: $pull_out"
      else
        knot_log_err "Failed to git pull in $KNOT_ROOT: $pull_out"
        [ "$target" != "--all" ] && return 1
      fi
    else
      knot_log_warn "$KNOT_ROOT is not a git repository. Skipping git pull."
    fi

    # Verify and heal binaries & permissions
    chmod +x "$KNOT_ROOT/bin/"*
    local user_home
    user_home="$(knot_detect_user_home)"
    mkdir -p "$user_home/.local/bin"
    ln -sf "$KNOT_ROOT/bin/knot" "$user_home/.local/bin/knot"
    if [ -x "$KNOT_ROOT/bin/knot-installer" ]; then
      ln -sf "$KNOT_ROOT/bin/knot-installer" "$user_home/.local/bin/knot-installer"
    fi

    # Restart worker services safely without dropping KVM
    knot_log_info "Refreshing worker services on $my_host (preserving KVM)..."
    for unit in knot-agent.service knot-stripd.service knot-hub.service; do
      if systemctl --user is-active --quiet "$unit"; then
        if r_out="$(systemctl --user restart "$unit" 2>&1)"; then
          knot_log_ok "$unit restarted."
        else
          knot_log_warn "Failed to restart $unit: $r_out"
        fi
      fi
    done
    knot_log_ok "Local development node update complete."

    if [ "$target" = "local" ] || [ "$target" = "$my_host" ]; then
      return 0
    fi
  fi

  # 2. Remote / Fleet update from Anchor
  local strands=()
  if [ "$target" = "--all" ]; then
    local nodes_dir=""
    if nodes_dir="$(knot_get_nodes_dir)"; then
      for manifest in "$nodes_dir/"*.json; do
        [ -e "$manifest" ] || continue
        local n_id n_role n_host
        n_id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        n_role="$(awk -F'"' '/"role":/ {print $4}' "$manifest")"
        n_host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        if [ "$n_role" = "anchor" ] || [ "$n_id" = "$anchor_id" ] || [ "$n_host" = "$anchor_host" ] || [ "$n_id" = "$my_host" ]; then
          continue
        fi
        if [ -n "$n_id" ]; then
          strands+=("$n_id")
        fi
      done
    fi
    if [ ${#strands[@]} -eq 0 ]; then
      strands=("laptop" "rog-ally" "steamdeck")
    fi
  else
    strands=("$target")
  fi

  knot_log_info "Dev update: Orchestrating git pull & service refresh across: ${strands[*]}..."

  for strand in "${strands[@]}"; do
    echo -e "\n${C_CYAN}=== Updating Dev Strand: [$strand] ===${C_RESET}"
    local probe_out=""
    if ! probe_out="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" "true" 2>&1)"; then
      knot_log_warn "Strand '$strand' is unreachable: $probe_out. Skipping."
      continue
    fi

    # Lockout check for remote strand
    local strand_type=""
    if ! strand_type="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" '
      if [ -f "$HOME/.config/knot/install_type" ]; then
        tr -d "[:space:]" < "$HOME/.config/knot/install_type"
      elif [ -d "$HOME/Dev/knot-mesh/.git" ] || [ -d "$HOME/knot-mesh/.git" ]; then
        echo "dev"
      else
        echo "prod"
      fi
    ' 2>&1)"; then
      knot_log_warn "Notice: Unable to probe install type on '$strand': $strand_type"
      strand_type="unknown"
    fi

    if [ "$strand_type" = "prod" ] && [ "$force_dev" -eq 0 ]; then
      knot_log_warn "Strand '$strand' is a PRODUCTION installation. Skipping dev update (use --force-dev to bypass)."
      continue
    fi

    local remote_dev_script='
      set -euo pipefail
      DEV_DIR=""
      for cand in "$HOME/Dev/knot-mesh" "$HOME/knot-mesh" "$HOME/.local/share/knot-mesh"; do
        if [ -d "$cand/.git" ]; then
          DEV_DIR="$cand"
          break
        fi
      done

      if [ -z "$DEV_DIR" ]; then
        echo "ERROR: No knot-mesh git repository found on target node."
        exit 1
      fi

      echo "Updating $DEV_DIR via git pull --ff-only..."
      git -C "$DEV_DIR" pull --ff-only

      chmod +x "$DEV_DIR/bin/"*
      mkdir -p "$HOME/.local/bin"
      ln -sf "$DEV_DIR/bin/knot" "$HOME/.local/bin/knot"
      if [ -x "$DEV_DIR/bin/knot-installer" ]; then
        ln -sf "$DEV_DIR/bin/knot-installer" "$HOME/.local/bin/knot-installer"
      fi

      for u in knot-agent.service knot-stripd.service; do
        if systemctl --user is-active --quiet "$u"; then
          systemctl --user restart "$u"
          echo "  [✓] $u restarted"
        fi
      done
    '

    local strand_out=""
    if strand_out="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$strand" "$remote_dev_script" 2>&1)"; then
      echo "$strand_out"
      knot_log_ok "Strand '$strand' dev update succeeded."
    else
      knot_log_err "Strand '$strand' dev update failed: $strand_out"
    fi
  done

  knot_log_ok "Fleet development update complete."
  echo ""
  knot_log_info "Verifying mesh status post-update..."
  cmd_status
}

cmd_update() {
  local target="local"
  local force=0
  local dev_mode=0
  local force_prod=0
  local force_dev=0
  local orig_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        echo -e "${C_BOLD}knot update - Swarm-Wide Binary & Module Updater${C_RESET}"
        echo "Usage:"
        echo "  knot update [options]               Check and update local node from GitHub release"
        echo "  knot update --all [options]         Anchor mode: Coordinated rollout across all active Strands"
        echo "  knot update <node_id> [options]     Roll out update to a specific mesh node"
        echo ""
        echo "Options:"
        echo "  --dev          Development mode: fast-forward git pull, binary audit, safe service restarts"
        echo "  --force-prod   Bypass development lockout to run production update on a dev node"
        echo "  --force-dev    Bypass production lockout to run dev update on a prod node"
        echo "  -f, --force    Force reinstall/download even if version matches"
        echo "  -h, --help     Show this help message"
        return 0
        ;;
      --dev)
        dev_mode=1
        orig_args+=("$1")
        shift
        ;;
      --force-prod)
        force_prod=1
        orig_args+=("$1")
        shift
        ;;
      --force-dev)
        force_dev=1
        orig_args+=("$1")
        shift
        ;;
      -f|--force)
        force=1
        orig_args+=("$1")
        shift
        ;;
      --all)
        target="--all"
        orig_args+=("$1")
        shift
        ;;
      local)
        target="local"
        shift
        ;;
      *)
        target="$1"
        orig_args+=("$1")
        shift
        ;;
    esac
  done

  # Safety Lockouts
  if [ $dev_mode -eq 1 ]; then
    knot_enforce_lockout "dev" "knot update" $force_dev || return 1
    cmd_update_dev "$target" $force_dev
    return $?
  else
    knot_enforce_lockout "prod" "knot update" $force_prod || return 1
  fi

  if [ "$target" = "local" ]; then
    local local_ver="${KNOT_VERSION:-1.0.0}"
    knot_log_info "Checking for latest Knot Mesh release (current: v${local_ver})..."

    local remote_tag=""
    if command -v gh >/dev/null; then
      local gh_out=""
      if gh_out="$(gh release view --json tagName -q .tagName 2>&1)"; then
        remote_tag="$(echo "$gh_out" | tr -d '[:space:]')"
      fi
    fi

    if [ -z "$remote_tag" ] && command -v curl >/dev/null; then
      local curl_out=""
      if curl_out="$(curl -sSfL -H "Accept: application/vnd.github+json" https://api.github.com/repos/kuasha420/knot-mesh/releases/latest 2>&1)"; then
        remote_tag="$(echo "$curl_out" | grep '"tag_name":' | head -n1 | cut -d '"' -f 4 | tr -d '[:space:]')"
      fi
    fi

    if [ -z "$remote_tag" ]; then
      knot_log_err "Failed to fetch latest release tag from GitHub."
      return 1
    fi

    local clean_remote="${remote_tag#v}"
    local clean_local="${local_ver#v}"

    if [ "$clean_remote" = "$clean_local" ] && [ $force -eq 0 ]; then
      knot_log_ok "Knot Mesh is up to date (${remote_tag})."
      return 0
    fi

    knot_log_info "Updating Knot Mesh: v${clean_local} -> ${remote_tag}..."

    local tmp_dir=""
    tmp_dir="$(mktemp -d)"
    local tarball="$tmp_dir/release.tar.gz"

    knot_log_info "Downloading release tarball (${remote_tag})..."
    local dl_url="https://github.com/kuasha420/knot-mesh/archive/refs/tags/${remote_tag}.tar.gz"
    local dl_err=""
    if ! dl_err="$(curl -sSfL "$dl_url" -o "$tarball" 2>&1)"; then
      knot_log_err "Failed to download release archive from $dl_url: $dl_err"
      rm -rf "$tmp_dir"
      return 1
    fi

    knot_log_info "Extracting release tarball..."
    local tar_err=""
    if ! tar_err="$(tar -xzf "$tarball" -C "$tmp_dir" 2>&1)"; then
      knot_log_err "Failed to extract release archive: $tar_err"
      rm -rf "$tmp_dir"
      return 1
    fi

    local extracted_root=""
    extracted_root="$(find "$tmp_dir" -mindepth 1 -maxdepth 1 -type d | head -n1)"
    if [ -z "$extracted_root" ] || [ ! -d "$extracted_root" ]; then
      knot_log_err "Failed to locate extracted release directory in $tmp_dir"
      rm -rf "$tmp_dir"
      return 1
    fi

    local user_home
    user_home="$(knot_detect_user_home)"
    local bin_dest="$user_home/.local/bin"
    mkdir -p "$bin_dest"

    local target_root="$KNOT_ROOT"
    if [ -d "$KNOT_ROOT/.git" ] && [ -d "$user_home/.local/share/knot-mesh" ]; then
      target_root="$user_home/.local/share/knot-mesh"
    elif [ ! -w "$target_root" ] || [ ! -d "$target_root/core" ]; then
      target_root="$user_home/.local/share/knot-mesh"
    fi
    mkdir -p "$target_root/bin" "$target_root/core"

    if [ -d "$extracted_root/core" ]; then
      knot_log_info "Installing core libraries to $target_root/core/..."
      cp -r "$extracted_root/core/"* "$target_root/core/"
      if [ "$target_root" != "$user_home/.local/share/knot-mesh" ] && [ -d "$user_home/.local/share/knot-mesh/core" ] && [ -w "$user_home/.local/share/knot-mesh/core" ]; then
        cp -r "$extracted_root/core/"* "$user_home/.local/share/knot-mesh/core/"
      fi
    fi

    if [ -d "$extracted_root/bin" ]; then
      knot_log_info "Installing binaries to $target_root/bin/ and $bin_dest/..."
      cp -r "$extracted_root/bin/"* "$target_root/bin/"
      chmod +x "$target_root/bin/"*
      for b in "$extracted_root/bin/"*; do
        [ -f "$b" ] || continue
        local b_name
        b_name="$(basename "$b")"
        if [ -L "$bin_dest/$b_name" ]; then
          local link_target
          link_target="$(readlink -f "$bin_dest/$b_name")"
          if [ -f "$link_target" ] && [ "$link_target" != "$extracted_root/bin/$b_name" ]; then
            if [[ "$link_target" != *"/Dev/"* ]] && [[ "$link_target" != *".git"* ]]; then
              cp -f "$b" "$link_target"
            fi
          fi
        else
          cp -f "$b" "$bin_dest/$b_name"
        fi
        chmod +x "$bin_dest/$b_name"
      done
    fi

    rm -rf "$tmp_dir"

    knot_log_info "Refreshing systemd services (preserving active KVM sessions)..."
    if systemctl --user is-active --quiet knot-agent.service; then
      systemctl --user restart knot-agent.service
      knot_log_ok "knot-agent.service restarted."
    fi
    if systemctl --user is-active --quiet knot-stripd.service; then
      systemctl --user restart knot-stripd.service
      knot_log_ok "knot-stripd.service restarted."
    fi

    knot_log_ok "Local Knot Mesh update complete (${remote_tag})."
    return 0
  fi

  local my_host my_node_id
  my_host="$(knot_detect_hostname)"
  my_node_id="$(knot_detect_node_id)"
  local active_swarm
  active_swarm="$(knot_get_active_swarm)"
  local anchor_id="desktop"
  local anchor_host="desktop"
  if knot_load_swarm_profile "$active_swarm"; then
    anchor_id="${ANCHOR_ID:-desktop}"
    anchor_host="${ANCHOR_HOST:-desktop}"
  fi

  local is_anchor=0
  if knot_is_anchor || [ "$anchor_id" = "$my_node_id" ] || [ "$anchor_id" = "$my_host" ] || [ "$anchor_host" = "$my_host" ]; then
    is_anchor=1
  fi

  # If run on a Strand, delegate to the Anchor
  if [ $is_anchor -eq 0 ]; then
    knot_log_info "Node '$my_node_id' is a Strand. Delegating fleet update to Anchor ($anchor_id)..."
    local remote_cmd="export PATH=\"\$HOME/.local/bin:\$PATH\"; export KNOT_NODE_ID=\"$anchor_id\"; knot update"
    if [ ${#orig_args[@]} -gt 0 ]; then
      remote_cmd="$remote_cmd ${orig_args[*]}"
    fi
    if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$anchor_id" "$remote_cmd"; then
      knot_log_err "Failed to execute update on Anchor ($anchor_id)"
      return 1
    fi
    return 0
  fi

  # We are on the Anchor
  local strands=()
  if [ "$target" = "--all" ]; then
    local nodes_dir=""
    if nodes_dir="$(knot_get_nodes_dir)"; then
      for manifest in "$nodes_dir/"*.json; do
        [ -e "$manifest" ] || continue
        local n_id n_role n_host
        n_id="$(awk -F'"' '/"id":/ {print $4}' "$manifest")"
        n_role="$(awk -F'"' '/"role":/ {print $4}' "$manifest")"
        n_host="$(awk -F'"' '/"hostname":/ {print $4}' "$manifest")"
        if [ "$n_role" = "anchor" ] || [ "$n_id" = "$anchor_id" ] || [ "$n_host" = "$anchor_host" ]; then
          continue
        fi
        if [ -n "$n_id" ]; then
          strands+=("$n_id")
        fi
      done
    fi
    if [ ${#strands[@]} -eq 0 ]; then
      strands=("laptop" "rog-ally" "steamdeck")
    fi
  else
    strands=("$target")
  fi

  knot_log_info "Anchor mode: Orchestrating rollout across strands: ${strands[*]}..."

  for strand in "${strands[@]}"; do
    echo -e "\n${C_CYAN}=== Rolling out update to Strand: [$strand] ===${C_RESET}"

    local probe_out=""
    if ! probe_out="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" "true" 2>&1)"; then
      knot_log_warn "Strand '$strand' is unreachable: $probe_out. Skipping."
      continue
    fi

    # Check if remote strand is a development installation
    local strand_install_type=""
    if ! strand_install_type="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" '
      if [ -f "$HOME/.config/knot/install_type" ]; then
        tr -d "[:space:]" < "$HOME/.config/knot/install_type"
      elif [ -d "$HOME/Dev/knot-mesh/.git" ] || [ -d "$HOME/knot-mesh/.git" ]; then
        echo "dev"
      else
        echo "prod"
      fi
    ' 2>&1)"; then
      knot_log_warn "Notice: Unable to probe install type on '$strand': $strand_install_type"
      strand_install_type="unknown"
    fi

    if [ "$strand_install_type" = "dev" ] && [ $force_prod -eq 0 ]; then
      knot_log_warn "Strand '$strand' is running a DEVELOPMENT installation. Skipping production binary overwrite."
      echo -e "  (Run 'knot update --dev $strand' or pass --force-prod to override)"
      continue
    fi

    local strand_root=""
    strand_root="$(ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" '
      if [ -L "$HOME/.local/bin/knot" ]; then
        p="$(readlink -f "$HOME/.local/bin/knot")"
        dirname "$(dirname "$p")"
      elif [ -d "$HOME/.local/share/knot-mesh" ]; then
        echo "$HOME/.local/share/knot-mesh"
      elif [ -d "$HOME/knot-mesh" ]; then
        echo "$HOME/knot-mesh"
      else
        echo "$HOME/.local/share/knot-mesh"
      fi
    ')"

    if [ -z "$strand_root" ]; then
      knot_log_err "Failed to determine Knot root directory on $strand"
      continue
    fi

    knot_log_info "Target root on $strand: $strand_root"

    ssh -o BatchMode=yes "$strand" "mkdir -p '$strand_root/bin' '$strand_root/core' \"\$HOME/.local/bin\""

    if ssh -o BatchMode=yes -o ConnectTimeout=4 "$strand" "command -v rsync >/dev/null" 2>&1; then
      knot_log_info "Syncing binaries to $strand:$strand_root/bin/..."
      rsync -az --exclude '__pycache__' "$KNOT_ROOT/bin/" "$strand:$strand_root/bin/"

      knot_log_info "Syncing core modules to $strand:$strand_root/core/..."
      rsync -az --exclude '__pycache__' "$KNOT_ROOT/core/" "$strand:$strand_root/core/"
    else
      knot_log_info "Syncing binaries and core modules to $strand:$strand_root/ via streaming tar fallback..."
      tar -czf - --exclude='__pycache__' -C "$KNOT_ROOT" bin core | ssh -o BatchMode=yes "$strand" "tar -xzf - -C '$strand_root'"
    fi

    ssh -o BatchMode=yes "$strand" "
      chmod +x '$strand_root/bin/'*
      for b in '$strand_root/bin/'*; do
        [ -f \"\$b\" ] || continue
        base=\"\$(basename \"\$b\")\"
        if [ ! -L \"\$HOME/.local/bin/\$base\" ] && [ ! -f \"\$HOME/.local/bin/\$base\" ]; then
          ln -sf \"\$b\" \"\$HOME/.local/bin/\$base\"
        elif [ -L \"\$HOME/.local/bin/\$base\" ]; then
          ln -sf \"\$b\" \"\$HOME/.local/bin/\$base\"
        fi
        chmod +x \"\$HOME/.local/bin/\$base\"
      done
    "

    knot_log_info "Restarting services on $strand without interrupting KVM..."
    ssh -o BatchMode=yes "$strand" '
      if systemctl --user is-active --quiet knot-agent.service; then
        systemctl --user restart knot-agent.service
        echo "  [✓] knot-agent.service restarted"
      fi
      if systemctl --user is-active --quiet knot-stripd.service; then
        systemctl --user restart knot-stripd.service
        echo "  [✓] knot-stripd.service restarted"
      fi
    '

    knot_log_ok "Strand '$strand' updated successfully."
  done

  knot_log_ok "Swarm-wide fleet rollout complete."
}

cmd_worktree() {
  local action="${1:-list}"
  if [ $# -gt 0 ]; then shift; fi

  case "$action" in
    add)
      local repo_name=""
      local wt_name=""
      local branch=""
      local base_ref="HEAD"
      local nodes=""

      while [ $# -gt 0 ]; do
        case "$1" in
          --branch|-b) branch="$2"; shift 2 ;;
          --base) base_ref="$2"; shift 2 ;;
          --nodes) nodes="$2"; shift 2 ;;
          *)
            if [ -z "$repo_name" ]; then
              repo_name="$1"
            elif [ -z "$wt_name" ]; then
              wt_name="$1"
            fi
            shift
            ;;
        esac
      done

      if [ -z "$repo_name" ] || [ -z "$wt_name" ]; then
        knot_log_err "Usage: knot worktree add <repo_or_project> <worktree_name> [--branch <branch>] [--base <ref>] [--nodes <node1,node2>]"
        return 1
      fi

      if [ -n "$nodes" ]; then
        gitops_provision_worktree_mesh "$repo_name" "$wt_name" "$branch" "$nodes" "$base_ref"
      else
        local repo_dir
        if ! repo_dir="$(gitops_find_repo "$repo_name")"; then
          knot_log_err "Repository or project '$repo_name' not found."
          return 1
        fi
        gitops_worktree_add "$repo_dir" "$wt_name" "$branch" "$base_ref"
      fi
      ;;
    remove|rm)
      local repo_name="${1:-}"
      local wt_name="${2:-}"
      local force=0
      while [ $# -gt 0 ]; do
        case "$1" in
          -f|--force) force=1; shift ;;
          *)
            if [ -z "$repo_name" ]; then
              repo_name="$1"
            elif [ -z "$wt_name" ]; then
              wt_name="$1"
            fi
            shift
            ;;
        esac
      done
      if [ -z "$repo_name" ] || [ -z "$wt_name" ]; then
        knot_log_err "Usage: knot worktree remove <repo_or_project> <worktree_name> [--force]"
        return 1
      fi
      local repo_dir
      if ! repo_dir="$(gitops_find_repo "$repo_name")"; then
        knot_log_err "Repository or project '$repo_name' not found."
        return 1
      fi
      gitops_worktree_remove "$repo_dir" "$wt_name" "$force"
      ;;
    list)
      local repo_name="${1:-}"
      local repo_dir=""
      if [ -n "$repo_name" ]; then
        if ! repo_dir="$(gitops_find_repo "$repo_name")"; then
          knot_log_err "Repository or project '$repo_name' not found."
          return 1
        fi
      else
        repo_dir="$(git rev-parse --show-toplevel 2>&1 || echo "$KNOT_ROOT")"
      fi
      gitops_worktree_list "$repo_dir"
      ;;
    normalize)
      local path_to_norm="${1:-}"
      local target_h="${2:-}"
      if [ -z "$path_to_norm" ]; then
        knot_log_err "Usage: knot worktree normalize <path> [target_home]"
        return 1
      fi
      knot_path_normalize "$path_to_norm" "$target_h"
      ;;
    provision)
      gitops_provision_worktree_mesh "$@"
      ;;
    *)
      echo "Usage: knot worktree <add|remove|list|normalize|provision> [args]"
      return 1
      ;;
  esac
}

case "${1:-}" in
  worktree)
    shift
    cmd_worktree "$@"
    ;;
  update)
    shift
    cmd_update "$@"
    ;;
  -v|--version|version)
    echo "knot-mesh version ${KNOT_VERSION:-1.0.0}"
    ;;
  mcp)
    shift
    cmd_mcp "$@"
    ;;
  onboard)
    shift
    cmd_onboard "$@"
    ;;
  sync)
    shift
    cmd_sync "$@"
    ;;
  resolve)
    shift
    cmd_resolve "$@"
    ;;
  status)
    cmd_status
    ;;
  exec)
    shift
    cmd_exec "$@"
    ;;
  kvm)
    shift
    cmd_kvm "$@"
    ;;
  screen)
    shift
    cmd_screen "$@"
    ;;
  unlock)
    shift
    screen_unlock "$@"
    ;;
  lock)
    shift
    screen_lock "$@"
    ;;
  login)
    shift
    screen_login "$@"
    ;;
  autologin)
    shift
    cmd_autologin "$@"
    ;;
  kdeconnect)
    shift
    cmd_kdeconnect "$@"
    ;;
  display)
    shift
    cmd_display "$@"
    ;;
  council)
    shift
    cmd_council "$@"
    ;;
  swarm)
    shift
    cmd_swarm "$@"
    ;;
  color|palette)
    shift
    cmd_color "$@"
    ;;
  quota)
    shift
    cmd_swarm quota "$@"
    ;;
  auth)
    shift
    cmd_auth "$@"
    ;;
  hub)
    shift
    cmd_hub "$@"
    ;;
  agent)
    shift
    cmd_agent "$@"
    ;;
  task)
    shift
    cmd_task "$@"
    ;;
  project)
    shift
    cmd_project "$@"
    ;;
  chat)
    shift
    cmd_chat "$@"
    ;;
  artifact)
    shift
    cmd_artifact "$@"
    ;;
  sleep|power)
    shift
    cmd_sleep "$@"
    ;;
  kafe|cockpit|web)
    shift
    cmd_web "$@"
    ;;
  memory)
    shift
    cmd_memory "$@"
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    ;;
  repair)
    shift
    cmd_repair "$@"
    ;;
  restart)
    shift
    if [ "${1:-}" = "kvm" ] || [ -z "${1:-}" ]; then
      cmd_kvm restart
    else
      knot_log_err "Unknown restart target: $1"
      exit 1
    fi
    ;;
  shutdown)
    shift
    cmd_shutdown "$@"
    ;;
  reboot)
    shift
    cmd_shutdown --reboot "$@"
    ;;
  topology)
    shift
    cmd_topology "$@"
    ;;
  *)
    echo -e "${C_BOLD}Knot - Multi-Device Mesh Orchestrator${C_RESET}"
    echo "Usage:"
    echo "  knot update [--all|<node_id>] [--dev] Update Knot binaries & core modules (or dev git pull)"
    echo "  knot topology [show|refresh]  Visual multi-screen spatial layout & photo refresh"
    echo "  knot onboard [node_id]        Enroll current device into the mesh"
    echo "  knot sync [--all | <node_id>] [--dev] Reconcile keys, configs, layout, or heal dev drift"
    echo "  knot resolve <node_id> [port] Resolve active IP across 3 tiers"
    echo "  knot status                   Show live status of all mesh nodes"
    echo "  knot council <start|resume|status|reply|list|attach|reconcile|copy|clean|kill> Out-of-band multi-agent swarm coordination"
    echo "  knot swarm [status|quota|test|exec|auth] Manage Antigravity AI agents across the mesh"
    echo "  knot quota [node|--all]       Show real-time 5h & weekly model quota limits"
    echo "  knot auth [<node_id>|--all] <login|import|list|status|switch|remove|test-lock> Manage profiles & authentication"
    echo "  knot memory [store|recall|map|promote|relate|test] Manage Cognitive Memory Palace"
    echo "  knot hub <start|stop|restart|status|logs> Manage Blackboard Hub daemon"
    echo "  knot agent <start|stop|restart|status|logs> Manage Worker Agent daemon"
    echo "  knot task <post|list|batch|get|wait|watch> Manage Linda Tuplespace tasks"
    echo "  knot project <list|get|sync|worktree> Manage native Antigravity multi-folder projects"
    echo "  knot worktree <add|remove|list|normalize|provision> Cross-node git worktrees without duplicate clones"
    echo "  knot chat <channels|create|post|read> Manage Swarm Konversations channels"
    echo "  knot sleep <status|prevent|allow> Enforce wholesale prevent-sleep on AC power"
    echo "  knot kafe [open|dev|build]    Boot / open Knot Kommand Kafe cockpit"
    echo "  knot web [dev|build|install]  Manage React & @assistant-ui Web Cockpit"
    echo "  knot doctor [node|--all]      Diagnose mesh, KVM, and portal health"
    echo "  knot repair [node|--all]      Auto-repair KVM dropout and mesh state"
    echo "  knot shutdown [target] [opt]  Graceful swarm-wide shutdown or reboot (--all, -d, -r, -c)"
    echo "  knot reboot [target] [opt]    Graceful swarm-wide reboot alias"
    echo "  knot exec <target|--all> <cmd> Run commands across mesh nodes"
    echo "  knot kvm <restart|status>     Manage software KVM across the mesh"
    echo "  knot screen <status|unlock|lock|login> Manage screen lock/login states"
    echo "  knot autologin [status|check|doctor|migrate-dm|local|reconcile|fix-kwallet] Manage auto-login"
    echo "  knot kdeconnect <status|sync|pair|share|sync-clipboard|test-clipboard|prune-stale> Manage KDE Connect mesh clipboard"
    exit 0
    ;;
esac
