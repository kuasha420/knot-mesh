[Unit]
Description=Knot Multi-Swarm Network Guard
After=network.target default.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if [ -x %h/.local/bin/knot-guard ]; then exec %h/.local/bin/knot-guard --immediate; elif [ -x /usr/local/bin/knot-guard ]; then exec /usr/local/bin/knot-guard --immediate; else echo "[knot-guard] Notice: knot-guard runner not installed; skipping immediate run." >&2; fi'
RemainAfterExit=yes

[Install]
WantedBy=default.target
